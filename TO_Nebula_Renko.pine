lengthBB = input.int(20, minval=1, group="TRAMPOLINE Bollinger Bands")
srcBB = input.string("close", title="Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group="TRAMPOLINE Bollinger Bands")
multBB = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group="TRAMPOLINE Bollinger Bands")
offsetBB = input.int(0, "Offset", minval = -500, maxval = 500, group="TRAMPOLINE Bollinger Bands")

sqTolerance = input.int(2, title="Squeeze Tolerance (lower = more sensitive)", group="Relaxing Settings", tooltip="How many bars to look back on the squeeze indicator")
adxSqueezeQ = input.int(21, title="ADX Threshold for TTM Squeeze", group="Relaxing Settings", tooltip="Anything over 19 filters out low volume periods. Set to 11 as a default, feel free to increase to get less noise")

color violetVectorColor = input.color(title='Violet',defval=color.fuchsia, inline='vectors', group="Vector Candle Settings")
color blueVectorColor = input.color(title='Blue', defval=color.rgb(83, 144, 249), inline='vectors', tooltip='Bull bars are green and bear bars are red when the bar is with volume >= 200% of the average volume of the 10 previous bars, or bars where the product of candle spread x candle volume is >= the highest for the 10 previous bars.\n Bull bars are blue and bear are violet when the bar is with with volume >= 150% of the average volume of the 10 previous bars.', group="Vector Candle Settings")
color regularCandleUpColor = input.color(title='Regular: Up Candle', defval=color.new(#02a433, 99), inline='nonVectors', group="Vector Candle Settings")
color regularCandleDownColor = input.color(title='Regular: Down Candle', defval=color.new(#a10101, 99), inline='nonVectors', tooltip='Bull bars are light gray and bear are dark gray when none of the red/green/blue/violet vector conditions are met.', group="Vector Candle Settings")

bApply25and75 = input(false, title="Apply 25/75 RSI rule", group="Shark Settings")

group3 = "Ultimate Buy Sell"
watchSignalLookback = input.int(35, title="# of bars back to use Watch Signals", group=group3, step=1)
signalWaitPeriod = input.int(5, title="# of bars before signals are allowed ", group=group3, step=1)
rsiSource = input.string("close", title="RSI Data Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group=group3)
rsiLength = input.int(32, title="RSI Length", minval=1, group=group3)
rsiBasisLength = input.int(32, title="RSI Basis Length", minval=1, group=group3)
rsiMultiplier = input.float(2, minval=1, maxval=3, step=0.1, title="RSI Band Multiplier", group=group3)
wmaLength = input.int(3, title="Smoothing Length", minval=1, group=group3)
useRsiWatchSignals = input(true, title="RSI Watch Signals", group=group3)
priceBasisLength = input.int(20, title="Price BBand Basis Length", group=group3)
priceInnerMultiplier = input.float(2, minval=1, maxval=4, step=0.1, title="Price Inner BB Multiplier", group=group3)
priceOuterMultiplier = input.float(2.5, minval=2, maxval=6, step=0.1, title="Price Outer BB Multiplier", group=group3)
usePriceBandWatchSignals = input(true, title="Bollinger Band Watch Signals", group=group3)
atrPeriod = input.int(30, title="ATR Period", group=group3)
maPeriod = input.int(10, title="ATR MA Period", group=group3)
atrMult = input.float(1.5, minval=1, step=0.1, title="ATR Band multiplier", group=group3)
atrMaType = input.string("WMA", title="ATR Moving Average Type", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], group=group3)
useAtrWatchSignals = input(true, title="ATR watch signals", group=group3)
useRsiSignals = input(true, title="RSI crossing Basis", group=group3)
use75Signals = input(true, title="RSI crossing under 75", group=group3)
use25Signals = input(true, title="RSI crossing over 25", group=group3)
useRsiMa = input(true, title="Rsi Crossing a Moving Average", group=group3)
rsiMaLength = input.int(24, title="Length of additional RSI MA", inline="rsiMa", minval=1, group=group3)
rsiMaType2 = input.string("WMA", title="Moving Average Type", inline="rsiMa", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], group=group3)
fast_length = input.int(12, title="Fast Length", group=group3)
slow_length = input.int(26, title="Slow Length", group=group3)
signal_length = input.int(title="Smoothing", minval=1, maxval=50, defval=9, group=group3)
sma_source = input.string(title="MACD Line MA Type", defval="EMA", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], group=group3)
sma_signal = input.string(title="Signal Line MA Type", defval="EMA", options=["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], group=group3)

rlength  = input.int(12, minval=1)
DER_avg = input.int(5, 'Average', minval=1, inline='DER', group='Directional Energy Ratio')
MA_Type5 = input.string('WMA', 'DER MA type', options=['WMA', 'EMA', 'SMA'], inline='DER', group='Directional Energy Ratio')
rsmooth  = input.int(3, 'Smooth', minval=1,  inline='DER_1', group='Directional Energy Ratio')
show_senti = input.bool(true, 'Sentiment',  inline='DER_s', group='Directional Energy Ratio')
senti   = input.int(20, 'Length', minval=1, inline='DER_s', group='Directional Energy Ratio')
v_calc  = input.string('Relative', 'Calculation', options=['Relative', 'Full', 'None'], group='Volume Parameters')
vlookbk = input.int(20, 'Lookback (for Relative)', minval=1, group='Volume Parameters')

wlengthBB = input.int(20, minval=1, group="Wicking Bollinger Bands")
wsrcBB = input.string("close", title="Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group="Wicking Bollinger Bands")
wmultBB = input.float(2.5, minval=0.001, maxval=50, title="StdDev", group="Wicking Bollinger Bands")
woffsetBB = input.int(0, "Offset", minval = -500, maxval = 500, group="Wicking Bollinger Bands")

h = input.float(21., 'Lookback Window', minval=3., group='Rational Quadratic Kernel Estimate')
r = input.float(8., 'Relative Weighting', step=0.25, group='Rational Quadratic Kernel Estimate')
x_0 = input.int(15, "Start Regression at Bar", group='Rational Quadratic Kernel Estimate')

alphaLength = input.int(title="Alpha Length", defval=20, minval=1, group="HEMA settings")
gammaLength = input.int(title="Gamma Length", defval=20, minval=1, group="HEMA settings")
hemaSrc = input.string("close", title="Source", options=["close", "open", "high", "low", "hl2", "hlc3", "ohlc4"], group="HEMA settings")

colorBigGreen = Theme == "Standard" ? color.new(#00ff00, 0) : Theme == "Pinky and the Brain" ? color.new(#00f5f1, 0) : Theme == "Color Blind" ? color.new(#03fcf4, 0) : Theme == "Mellow Yellow" ? color.new(#35defc, 0) : na
colorBigRed = Theme == "Standard" ? color.new(#ff0000, 0) : Theme == "Pinky and the Brain" ? color.new(#fc03f8, 0) : Theme == "Color Blind" ? color.new(#fca903, 0) : Theme == "Mellow Yellow" ? color.new(#fcf11c, 0) : na

import TradersReality/Traders_Reality_Lib/2 as trLib

// =-=-=-=-=-=-=-=-=-=-=-=-=   HELPERS   =-=-=-=-=-=-=-=-=-=-=-=-=-= //

// Source selector evaluated inside the signal-TF context (input.source would point at Renko data)
f_src(string s) =>
    switch s
        "open"  => open
        "high"  => high
        "low"   => low
        "hl2"   => hl2
        "hlc3"  => hlc3
        "ohlc4" => ohlc4
        => close

dirmov(len) =>
    up5 = ta.change(high)
    down5 = -ta.change(low)
    plusDM = na(up5) ? na : (up5 > down5 and up5 > 0 ? up5 : 0)
    minusDM = na(down5) ? na : (down5 > up5 and down5 > 0 ? down5 : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

calc_macd(source, fastLength, slowLength) =>
    ta.ema(source, fastLength) - ta.ema(source, slowLength)

calc_BBUpper(source, length, mult) =>
    ta.sma(source, length) + mult * ta.stdev(source, length)

calc_BBLower(source, length, mult) =>
    ta.sma(source, length) - mult * ta.stdev(source, length)

maType(src, length, type) =>
    switch type
        "SMA" => ta.sma(src, length)
        "EMA" => ta.ema(src, length)
        "WMA" => ta.wma(src, length)
        "HMA" => ta.hma(src, length)
        "VWMA" => ta.vwma(src, length)
        "RMA" => ta.rma(src, length)

f_derma(_data, _len, MAOption) =>
    MAOption == 'SMA' ? ta.sma(_data, _len) : MAOption == 'EMA' ? ta.ema(_data, _len) : ta.wma(_data, _len)

f_LazyLine(_data, _length) =>
    w1 = 0, w2 = 0, w3 = 0
    L1 = 0.0, L2 = 0.0, L3 = 0.0
    w = _length / 3
    if _length > 2
        w2 := math.round(w)
        w1 := math.round((_length-w2)/2)
        w3 := int((_length-w2)/2)
        L1 := ta.wma(_data, w1)
        L2 := ta.wma(L1, w2)
        L3 := ta.wma(L2, w3)
    else
        L3 := _data
    L3

kernel_regression(_src, _size, _h) =>
    float _currentWeight = 0.
    float _cumulativeWeight = 0.
    for i = 0 to _size + x_0
        y = _src[i]
        w = math.pow(1 + (math.pow(i, 2) / ((math.pow(_h, 2) * 2 * r))), -r)
        _currentWeight += y*w
        _cumulativeWeight += w
    _currentWeight / _cumulativeWeight

f_cnt(bool b) =>
    ta.cum(b ? 1 : 0)


// =-=-=-=-=-=-=-=-=-=-=-=-=   NEBULA ENGINE (runs on signal timeframe)   =-=-=-=-=-=-=-=-=-=-=-=-=-= //

nebulaEngine() =>
    int iTPSignalCount = 0
    ema9 = ta.ema(close, 9)
    ema21 = ta.ema(close, 21)
    adxValue = adx(dilen, adxlen)
    sigabove19 = adxValue > adxSqueeze

    // ---- Cumulative Volume Delta © Ankit_1618
    upper_wick = close>open ? high-close : high-open
    lower_wick = close>open ? open-low : close-low
    spread = high-low
    body_length = spread - (upper_wick + lower_wick)
    percent_upper_wick = upper_wick/spread
    percent_lower_wick = lower_wick/spread
    percent_body_length = body_length/spread
    buying_volume = close > open ? (percent_body_length + (percent_upper_wick + percent_lower_wick)/2)*volume : ((percent_upper_wick + percent_lower_wick)/2) * volume
    selling_volume = close < open ? (percent_body_length + (percent_upper_wick + percent_lower_wick)/2)*volume : ((percent_upper_wick + percent_lower_wick)/2) * volume
    cumulative_volume_delta = ta.ema(buying_volume,14) - ta.ema(selling_volume,14)

    cCVDColor = color.white
    cCVDBorder = color.white
    cCVDWick = color.white
    if cumulative_volume_delta > 0
        cCVDColor := color.from_gradient(math.abs(cumulative_volume_delta), 0, iVolDeltaTop, color.new(colorBigGreen, 70), color.new(colorBigGreen, 0))
        cCVDBorder := cCVDColor
        cCVDWick := cCVDColor
    else if cumulative_volume_delta < 0
        cCVDColor := color.from_gradient(math.abs(cumulative_volume_delta), 0, iVolDeltaTop, color.new(colorBigRed, 70), color.new(colorBigRed, 0))
        cCVDBorder := cCVDColor
        cCVDWick := cCVDColor

    // ---- Dead Simple Reversal
    lo3 = ta.lowest(low,3)
    lo50 = ta.lowest(low,50)
    hi3 = ta.highest(high,3)
    hi50 = ta.highest(high,50)
    buyDSR = (close[1] < open[1] and close > open) and (close > open[1]) and (lo3 < lo50[1] or lo3 < lo50[2] or lo3 < lo50[3])
    sellDSR = (close[1] > open[1] and close < open) and (close < open[1]) and (hi3 > hi50[1] or hi3 > hi50[2] or hi3 > hi50[3])
    if (buyDSR or sellDSR) or (buyDSR[1] or sellDSR[1])
        iTPSignalCount += vDeadRev

    // ---- Reversal Signals [LuxAlgo]
    var int bSC = 0
    var int sSC = 0
    if close < close[4]
        bSC := bSC == 9 ? 1 : bSC + 1
        sSC := 0
    else
        sSC := sSC == 9 ? 1 : sSC + 1
        bSC := 0
    bShowUppies = bSC == 9 or (bSC[1] == 8 and sSC == 1)
    bShowDownies = sSC == 9 or (sSC[1] == 8 and bSC == 1)
    if (bShowUppies or bShowDownies) or (bShowUppies[1] or bShowDownies[1])
        iTPSignalCount += vLuxRev

    // ---- LuxAlgo Market Structure (Fractal)
    var float upClose = na
    var float downClose = na
    var float upperVal = na
    var float lowerVal = na
    dhT = math.sum(math.sign(high - high[1]), FRAC_PT)
    dlT = math.sum(math.sign(low - low[1]), FRAC_PT)
    bullf = dhT == -FRAC_PT and dhT[FRAC_PT] == FRAC_PT and high[FRAC_PT] == ta.highest(FRAC_LEN)
    bearf = dlT == FRAC_PT and dlT[FRAC_PT] == -FRAC_PT and low[FRAC_PT] == ta.lowest(FRAC_LEN)
    if bullf
        upperVal := high[FRAC_PT]
    if bearf
        lowerVal := low[FRAC_PT]
    xUp = ta.crossover(close, upperVal)
    xDn = ta.crossunder(close, lowerVal)
    if xUp
        upClose := close
    if xDn
        downClose := close

    // ---- Bixord FantailVMA + cloud sources
    rsi14 = ta.rsi(close, 14)
    mfi = ta.mfi(hlc3, 14)
    maCCI = ta.sma(hlc3, 20)
    cci = (hlc3 - maCCI) / (0.015 * ta.dev(hlc3, 20))
    float iSource = 0.0
    float MIN_CLOUD = 0.0
    float MID_CLOUD = 0.0
    float MAX_CLOUD = 0.0
    if cloudType=="Relative Strength"
        iSource := rsi14
        MIN_CLOUD := 20
        MID_CLOUD := 50
        MAX_CLOUD := 80
    if cloudType=="Money Flow"
        iSource := mfi
        MIN_CLOUD := 20
        MID_CLOUD := 50
        MAX_CLOUD := 80
    if cloudType=="Commodity Channel"
        iSource := cci
        MIN_CLOUD := 20
        MID_CLOUD := -100
        MAX_CLOUD := 100

    VarMA = close
    STR = high-low
    sPDI = 0.0
    sMDI = 0.0
    ADX = 0.0
    Bulls1 = 0.5*(math.abs(high-high[1])+(high-high[1]))
    Bears1 = 0.5*(math.abs(low[1]-low)+(low[1]-low))
    Bears = Bulls1 > Bears1 ? 0 : (Bulls1 == Bears1 ? 0 : Bears1)
    Bulls = Bulls1 < Bears1 ? 0 : (Bulls1 == Bears1 ? 0 : Bulls1)
    if bar_index > 0
        sPDI := (Weighting*sPDI[1] + Bulls)/(Weighting+1)
        sMDI := (Weighting*sMDI[1] + Bears)/(Weighting+1)
    TR = math.max(high-low, high-close[1])
    if bar_index > 0
        STR := (Weighting*STR[1] + TR)/(Weighting+1)
    PDI = STR > 0 ? sPDI/STR : 0
    MDI = STR > 0 ? sMDI/STR : 0
    DX = (PDI + MDI) > 0 ? math.abs(PDI - MDI)/(PDI + MDI) : 0
    if bar_index > 0
        ADX := (Weighting*ADX[1] + DX)/(Weighting+1)
    adxlow = ta.lowest(ADX, ADX_Length)
    adxmax = ta.highest(ADX, ADX_Length)
    ADXmin = math.min(1000000.0, adxlow)
    ADXmax = math.max(-1.0, adxmax)
    Diff = ADXmax - ADXmin
    Const = Diff > 0 ? (ADX - ADXmin)/Diff : 0
    if bar_index > 0
        VarMA := ((2-Const)*VarMA[1]+Const*close)/2
    FanVMA = ta.sma(VarMA, MA_Length)

    // ---- McGinley Dynamic
    mg = 0.0
    mg := na(mg[1]) ? ta.ema(close, 14) : mg[1] + (close - mg[1]) / (14 * math.pow(close/mg[1], 4))

    // ---- Waddah Attar Explosion v1 by LazyBear
    upperW = calc_BBUpper(close, channelLength, multWAE)
    lowerW = calc_BBLower(close, channelLength, multWAE)
    t1 = (calc_macd(close, fastLength, slowLength) - calc_macd(close[1], fastLength, slowLength))*sensitivity
    e1 = (upperW - lowerW)
    trendUpWAE = (t1 >= 0) ? t1 : 0
    trendDownWAE = (t1 < 0) ? (-1*t1) : 0

    cBodyColor = color.white
    cBorderColor = color.white
    cWickColor = color.white
    if (trendUpWAE > e1 and trendUpWAE > 0)
        cBodyColor := color.from_gradient(math.abs(trendUpWAE - e1), 1, iTopBody, color.new(colorBigGreen, 70), color.new(colorBigGreen, 0))
        cBorderColor := color.from_gradient(math.abs(trendUpWAE - e1), 1, iTopBorder, color.new(colorBigGreen, 70), color.new(colorBigGreen, 0))
        cWickColor := color.new(colorBigGreen, 0)
    if (trendUpWAE < e1 and trendUpWAE > 0)
        cBodyColor := color.new(colorBigGreen, 90)
        cBorderColor := color.from_gradient(math.abs(e1 - trendUpWAE), 1, iTopBody, color.new(colorBigGreen, 70), color.new(colorBigGreen, 0))
        cWickColor := color.new(colorBigGreen, 30)
    if (trendDownWAE > e1 and trendDownWAE > 0)
        cBodyColor := color.from_gradient(math.abs(trendDownWAE - e1), 1, iTopBody, color.new(colorBigRed, 50), color.new(colorBigRed, 0))
        cBorderColor := color.from_gradient(math.abs(trendDownWAE - e1), 1, iTopBorder, color.new(colorBigRed, 50), color.new(colorBigRed, 0))
        cWickColor := color.new(colorBigRed, 0)
    if (trendDownWAE < e1 and trendDownWAE > 0)
        cBodyColor := color.new(colorBigRed, 90)
        cBorderColor := color.from_gradient(math.abs(e1 - trendDownWAE), 1, iTopBody, color.new(colorBigRed, 50), color.new(colorBigRed, 0))
        cWickColor := color.new(colorBigRed, 30)

    // ---- TRAMPOLINE
    tSrc = f_src(rsiSourceInput)
    bbSrc = f_src(srcBB)
    isRed = close < open
    isGreen = close > open
    basisBB = ta.sma(bbSrc, lengthBB)
    devBB = multBB * ta.stdev(bbSrc, lengthBB)
    upperBB = basisBB + devBB
    lowerBB = basisBB - devBB
    bbw = (upperBB - lowerBB) / basisBB
    upT = ta.rma(math.max(ta.change(tSrc), 0), rsiLengthInput)
    downT = ta.rma(-math.min(ta.change(tSrc), 0), rsiLengthInput)
    rsiM = downT == 0 ? 100 : upT == 0 ? 0 : 100 - (100 / (1 + upT / downT))
    backC = isRed and rsiM <= RSIThreshold and close < lowerBB and bbw > iBBThreshold
    forC = isGreen and rsiM >= RSIDown and close > upperBB and bbw > iBBThreshold
    weGoUp = isGreen and (backC[1] or backC[2] or backC[3] or backC[4] or backC[5]) and (high > high[1])
    upThrust = weGoUp and not weGoUp[1] and not weGoUp[2] and not weGoUp[3] and not weGoUp[4]
    weGoDown = isRed and (forC[1] or forC[2] or forC[3] or forC[4] or forC[5]) and (low < low[1])
    downThrust = weGoDown and not weGoDown[1] and not weGoDown[2] and not weGoDown[3] and not weGoDown[4]
    if (upThrust or downThrust) or (upThrust[1] or downThrust[1])
        iTPSignalCount += vTramp

    // ---- Squeeze Relaxer version 2.1
    var int cGreen = 0
    var int cRed = 0
    basisSq = ta.sma(close, 20)
    dev1 = 1.5 * ta.stdev(close, 20)
    upperBBsq = basisSq + dev1
    lowerBBsq = basisSq - dev1
    maKC = ta.sma(close, 20)
    rangema = ta.sma(high - low, 20)
    upperKC = maKC + rangema * 1.5
    lowerKC = maKC - rangema * 1.5
    sqzOn  = (lowerBBsq > lowerKC) and (upperBBsq < upperKC)
    avg1 = math.avg(ta.highest(high, 20), ta.lowest(low, 20))
    avg2 = math.avg(avg1, ta.sma(close, 20))
    val = ta.linreg(close - avg2, 20, 0)
    pos = false
    neg = false
    if (val < nz(val[1]) and val < 5 and not sqzOn)
        cRed += 1
    if (val > nz(val[1]) and val > 5 and not sqzOn)
        cGreen += 1
    if (val > nz(val[1]) and cRed > sqTolerance and val < 5 and not pos[1] and sigabove19)
        cRed := 0
        pos := true
    if (val < nz(val[1]) and cGreen > sqTolerance and val > 5 and not neg[1] and sigabove19)
        cGreen := 0
        neg := true
    if (pos or neg) or (pos[1] or neg[1])
        iTPSignalCount += vSqueeze

    cSQColor = color.white
    cSQBorder = color.white
    cSQWick = color.white
    if val > 0
        if val > nz(val[1])
            cSQColor := color.from_gradient(math.abs(val), 0, 30, color.new(colorBigGreen, 50), color.new(colorBigGreen, 0))
            cSQBorder := colorBigGreen
            cSQWick := cSQColor
        if val < nz(val[1])
            cSQColor := color.new(colorBigGreen, 70)
            cSQBorder := color.new(color.black, 100)
            cSQWick := cSQColor
    else
        if val < nz(val[1])
            cSQColor := color.from_gradient(math.abs(val), 0, 30, color.new(colorBigRed, 50), color.new(colorBigRed, 0))
            cSQBorder := colorBigRed
            cSQWick := cSQColor
        if val > nz(val[1])
            cSQColor := color.new(colorBigRed, 50)
            cSQBorder := color.new(color.black, 100)
            cSQWick := cSQColor

    // ---- VECTOR CANDLES (PVSRA)
    [pvsraColor, alertFlag, averageVolume, volumeSpread, highestVolumeSpread] = trLib.calcPvsra(volume, high, low, close, open, colorBigRed, colorBigGreen, violetVectorColor, blueVectorColor, regularCandleDownColor, regularCandleUpColor)
    bVectorGreen = pvsraColor == colorBigGreen
    bVectorRed = pvsraColor == colorBigRed

    // ---- TOTAL RECALL
    bGreenSignal = bVectorGreen and (close == upClose or close[1] == upClose[1] or close[2] == upClose[2] or close[3] == upClose[3])
    bRedSignal = bVectorRed and (close == downClose or close[1] == downClose[1] or close[2] == downClose[2] or close[3] == downClose[3])
    if (bGreenSignal or bRedSignal) or (bGreenSignal[1] or bRedSignal[1])
        iTPSignalCount += vEarlyRev

    // ---- THE SHARK
    basis5 = ta.sma(rsiM, 30)
    devS = 2.0 * ta.stdev(rsiM, 30)
    upper7 = basis5 + devS
    lower7 = basis5 - devS
    bBelow25 = bApply25and75 ? rsiM < 26 : true
    bAbove75 = bApply25and75 ? rsiM > 74 : true
    bShowSharkUp = rsiM < lower7 and bBelow25
    bShowSharkDown = rsiM > upper7 and bAbove75
    if (bShowSharkUp or bShowSharkDown) or (bShowSharkUp[1] or bShowSharkDown[1])
        iTPSignalCount += vShark

    // ---- ULTIMATE BUY/SELL
    uSrc = f_src(rsiSource)
    atrValue = ta.atr(atrPeriod)
    atrMaValue = maType(close, maPeriod, atrMaType)
    upperAtrBand = atrMaValue + atrValue * atrMult
    lowerAtrBand = atrMaValue - atrValue * atrMult

    upU = ta.rma(math.max(ta.change(uSrc), 0), rsiLength)
    downU = ta.rma(-math.min(ta.change(uSrc), 0), rsiLength)
    rsiU = downU == 0 ? 100 : upU == 0 ? 0 : 100 - (100 / (1 + upU / downU))
    rsiBasis = ta.wma(rsiU, rsiBasisLength)
    rsiDeviation = ta.stdev(rsiU, rsiBasisLength)
    upperRsi = rsiBasis + rsiMultiplier * rsiDeviation
    lowerRsi = rsiBasis - rsiMultiplier * rsiDeviation
    rsiMaV = maType(rsiU, rsiMaLength, rsiMaType2)

    priceBasis = ta.sma(close, priceBasisLength)
    priceInnerDeviation = priceInnerMultiplier * ta.stdev(close, priceBasisLength)
    upperPriceInner = priceBasis + priceInnerDeviation
    lowerPriceInner = priceBasis - priceInnerDeviation

    priceCrossOverInner = ta.crossover(close, lowerPriceInner)
    priceCrossUnderInner = ta.crossunder(close, upperPriceInner)
    rsiCrossOverLower = ta.crossover(rsiU, lowerRsi)
    rsiCrossUnderUpper = ta.crossunder(rsiU, upperRsi)
    rsiCrossOverBasis = ta.crossover(rsiU, rsiBasis)
    rsiCrossUnderBasis = ta.crossunder(rsiU, rsiBasis)
    rsiCrossOverMa = ta.crossover(rsiU, rsiMaV)
    rsiCrossUnderMa = ta.crossunder(rsiU, rsiMaV)
    rsiCrossUnder75 = ta.crossunder(rsiU, 75)
    rsiCrossOver25 = ta.crossover(rsiU, 25)
    highUnderAtrLower = ta.crossunder(high, lowerAtrBand)
    lowOverAtrUpper = ta.crossover(low, upperAtrBand)

    var int[] buyWatchArray = array.new_int(0)
    var int[] sellWatchArray = array.new_int(0)

    buyWatched = (usePriceBandWatchSignals and priceCrossOverInner) or (useRsiWatchSignals and (rsiCrossOverLower or rsiCrossOver25)) or (useAtrWatchSignals and highUnderAtrLower)
    sellWatched = (usePriceBandWatchSignals and priceCrossUnderInner) or (useRsiWatchSignals and (rsiCrossUnderUpper or rsiCrossUnder75)) or (useAtrWatchSignals and lowOverAtrUpper)

    // same as original Nebula (pushes na, not 0) so the dot vs. ➊ split matches the 1m chart
    array.push(buyWatchArray, buyWatched ? 1 : na)
    array.push(sellWatchArray, sellWatched ? 1 : na)
    while array.size(buyWatchArray) > watchSignalLookback
        array.shift(buyWatchArray)
    while array.size(sellWatchArray) > watchSignalLookback
        array.shift(sellWatchArray)

    buyWatchMet = array.sum(buyWatchArray) >= 1
    sellWatchMet = array.sum(sellWatchArray) >= 1
    buySignals = buyWatchMet and (rsiCrossOverBasis or rsiCrossOver25 or rsiCrossOverMa)
    sellSignals = sellWatchMet and (rsiCrossUnderBasis or rsiCrossUnder75 or rsiCrossUnderMa)

    plotBuy = false
    plotSell = false
    if buySignals and not buyWatched
        plotBuy := true
        array.clear(buyWatchArray)
        array.clear(sellWatchArray)
    else if sellSignals and not sellWatched
        plotSell := true
        array.clear(sellWatchArray)
        array.clear(buyWatchArray)

    // ---- VODKA SHOT: Neglected Vol by DGT
    nzVolume = nz(volume)
    volAvgL  = ta.sma(nzVolume, 14 * 5)
    volDev   = (volAvgL + 1.618034 * ta.stdev(volAvgL, 14 * 5)) / volAvgL * 11 / 100
    volRel   = nzVolume / volAvgL

    // ---- RedK Dual VADER with Energy Bars
    vola = v_calc == 'None' or na(volume) ? 1 : v_calc == 'Relative' ? ta.stoch(volume, volume, volume, vlookbk) / 100 : volume
    R = (ta.highest(2) - ta.lowest(2)) / 2
    sr = ta.change(close) / R
    rsr = math.max(math.min(sr, 1), -1)
    vc = fixnan(rsr * vola)
    c_plus  = math.max(vc, 0)
    c_minus = -math.min(vc, 0)
    avg_vola = f_derma(vola, rlength, MA_Type5)
    dem = f_derma(c_plus, rlength, MA_Type5) / avg_vola
    sup = f_derma(c_minus, rlength, MA_Type5) / avg_vola
    adp = 100 * ta.wma(nz(dem), DER_avg)
    asp = 100 * ta.wma(nz(sup), DER_avg)
    bo = fixnan(asp)
    bc = fixnan(adp)
    rising = ta.change(bc) > 0
    isBarUp = bc > bo and rising
    isBarDn = bc < bo and not rising

    // ---- RedK Slow_Smooth WMA
    LL = f_LazyLine(close, 21)
    upwards = LL > LL[1] and isBarUp and nz(upU) != 0 and (open < close and volRel * .145898 > volDev)
    downwards = LL < LL[1] and isBarDn and (open > close and volRel * .145898 > volDev)
    pBuyVodka = upwards and not upwards[1] and not upwards[2] and not upwards[3] and not upwards[4]
    pSellVodka = downwards and not downwards[1] and not upwards[2] and not upwards[3] and not upwards[4]

    // ---- JOHN WICK
    wSrc = f_src(wsrcBB)
    wbasisBB = ta.sma(wSrc, wlengthBB)
    wdevBB = wmultBB * ta.stdev(wSrc, wlengthBB)
    wupperBB = wbasisBB + wdevBB
    wlowerBB = wbasisBB - wdevBB
    bBBUp = low <= wlowerBB and close >= wlowerBB and close < open
    bBBDown = high >= wupperBB and close < wupperBB and close > open
    if (bBBUp or bBBDown) or (bBBUp[1] or bBBDown[1])
        iTPSignalCount += vBands

    // ---- Rational Quadratic Kernel Estimate
    yhat1 = kernel_regression(close, 1, h)

    // ---- TIDAL WAVE (credit Aaron D)
    var int waveState = na
    redCandle = close < open
    greenCandle = close > open
    bDoji = math.abs(close - open) <= iMaxBody and bIgnoreDoji
    noOverlapRed = false
    noOverlapGreen = false
    brightGreen = false
    brightRed = false
    gapGreen = false
    gapRed = false

    if greenCandle and not bDoji
        for i = 1 to 200
            if brightRed[i]
                break
            else if waveState == upTrend and redCandle[i]
                break
            else if waveState == downTrend and open >= close[i] and greenCandle[i]
                noOverlapGreen := true
                brightGreen := true
                waveState := upTrend
                break
        if open >= close[1] and greenCandle[1]
            waveState := upTrend
            brightGreen := true
            gapGreen := true

    if redCandle and not bDoji
        for i = 1 to 200
            if brightGreen[i]
                break
            else if waveState == downTrend and greenCandle[i]
                break
            else if waveState == upTrend and open <= close[i] and redCandle[i]
                noOverlapRed := true
                brightRed := true
                waveState := downTrend
                break
        if redCandle[1] and open < close[1]
            waveState := downTrend
            brightRed := true
            gapRed := true

    var float gapPxG = na
    var float gapPxR = na
    if gapGreen
        gapPxG := open
    if gapRed
        gapPxR := open

    bBigBuy1 = plotBuy or plotBuy[1] or plotBuy[2] or plotBuy[3]
    bBigSell1 = plotSell or plotSell[1] or plotSell[2] or plotSell[3]

    // ---- HEMA
    hSrc = f_src(hemaSrc)
    alpha = 2.0 / (alphaLength + 1)
    gamma = 2.0 / (gammaLength + 1)
    bH = 0.
    hema = 0.
    hema := (1 - alpha) * (nz(hema[1]) + nz(bH[1], hSrc)) + alpha * hSrc
    bH := (1 - gamma) * nz(bH[1]) + gamma * (hema - nz(hema[1]))

    bSkullUp = bShow921 and (not bShowQuad ? ta.crossover(ema9, ema21) : ta.crossover(ema9, yhat1))
    bSkullDown = bShow921 and (not bShowQuad ? ta.crossunder(ema9, ema21) : ta.crossunder(ema9, yhat1))

    // ---- CLOUD COLOR
    color cColor = na
    if FanVMA > mg
        cColor := cloudType=="Simple" ? color.new(colorBigGreen, iSimpleCloud) : color.from_gradient(iSource, MID_CLOUD, MAX_CLOUD, color.new(colorBigGreen, iLowCloud), color.new(colorBigGreen, iHighCloud))
    else
        cColor := cloudType=="Simple" ? color.new(colorBigRed, iSimpleCloud) : color.from_gradient(iSource, MIN_CLOUD, MID_CLOUD, color.new(colorBigRed, iLowCloud), color.new(colorBigRed, iHighCloud))

    // ---- SIGNAL CONDITIONS (same logic as original plots)
    sBuyDot     = not bBigBuy1 and noOverlapGreen and waveState[1]==downTrend
    sSellDot    = not bBigSell1 and noOverlapRed and waveState[1]==upTrend
    sStrongBuy  = bBigBuy1 and noOverlapGreen and waveState[1]==downTrend
    sStrongSell = bBigSell1 and noOverlapRed and waveState[1]==upTrend
    sPlusG      = gapGreen and waveState[1]==upTrend
    sPlusR      = gapRed and waveState[1]==downTrend
    sVodkaB     = pBuyVodka and waveState[1]==upTrend
    sVodkaS     = pSellVodka and waveState[1]==downTrend
    sTPMaxUp    = iTPSignalCount >= iMaxProfit and waveState==upTrend
    sTPMaxDn    = iTPSignalCount >= iMaxProfit and waveState==downTrend
    sTPUp       = iTPSignalCount >= iProfit and waveState==upTrend
    sTPDn       = iTPSignalCount >= iProfit and waveState==downTrend

    [sBuyDot, sSellDot, sStrongBuy, sStrongSell, sPlusG, sPlusR, sVodkaB, sVodkaS, sTPMaxUp, sTPMaxDn, sTPUp, sTPDn, bSkullUp, bSkullDown, plotBuy, plotSell, gapGreen, gapRed, gapPxG, gapPxR, mg, FanVMA, iSource, hema, pvsraColor, cCVDColor, cCVDWick, cCVDBorder, cBodyColor, cWickColor, cBorderColor, cSQColor, cSQWick, cSQBorder]

// Converts each per-bar signal into a running count so no signal is lost or duplicated between Renko bricks
nebulaFeed() =>
    [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, pG, pR, mgV, fanV, cloudC, hemaV, pvC, cvdC, cvdW, cvdB, waeB, waeW, waeBr, sqC, sqW, sqB] = nebulaEngine()
    o = bNoRepaint ? 1 : 0
    n1 = f_cnt(s1)
    n2 = f_cnt(s2)
    n3 = f_cnt(s3)
    n4 = f_cnt(s4)
    n5 = f_cnt(s5)
    n6 = f_cnt(s6)
    n7 = f_cnt(s7)
    n8 = f_cnt(s8)
    n9 = f_cnt(s9)
    n10 = f_cnt(s10)
    n11 = f_cnt(s11)
    n12 = f_cnt(s12)
    n13 = f_cnt(s13)
    n14 = f_cnt(s14)
    n15 = f_cnt(s15)
    n16 = f_cnt(s16)
    n17 = f_cnt(s17)
    n18 = f_cnt(s18)
    [n1[o], n2[o], n3[o], n4[o], n5[o], n6[o], n7[o], n8[o], n9[o], n10[o], n11[o], n12[o], n13[o], n14[o], n15[o], n16[o], n17[o], n18[o], pG[o], pR[o], mgV, fanV, cloudC, hemaV, pvC, cvdC, cvdW, cvdB, waeB, waeW, waeBr, sqC, sqW, sqB]


// =-=-=-=-=-=-=-=-=-=-=-=-=   PULL SIGNALS ONTO THE RENKO CHART   =-=-=-=-=-=-=-=-=-=-=-=-=-= //

stdTicker = ticker.standard(syminfo.tickerid)

[nBuyDot, nSellDot, nStrongBuy, nStrongSell, nPlusG, nPlusR, nVodkaB, nVodkaS, nTPMaxUp, nTPMaxDn, nTPUp, nTPDn, nSkullUp, nSkullDn, nUltBuy, nUltSell, nGapG, nGapR, qGapPxG, qGapPxR, qMG, qFan, qCloud, qHema, qPv, qCvdC, qCvdW, qCvdB, qWaeB, qWaeW, qWaeBr, qSqC, qSqW, qSqB] = request.security(stdTicker, sigTF, nebulaFeed(), lookahead = barmerge.lookahead_off)

// true on the first brick after the signal count increased
f_new(float n) =>
    not na(n[1]) and n > n[1]

eBuyDot     = f_new(nBuyDot)
eSellDot    = f_new(nSellDot)
eStrongBuy  = f_new(nStrongBuy)
eStrongSell = f_new(nStrongSell)
ePlusG      = f_new(nPlusG)
ePlusR      = f_new(nPlusR)
eVodkaB     = f_new(nVodkaB)
eVodkaS     = f_new(nVodkaS)
eTPMaxUp    = f_new(nTPMaxUp)
eTPMaxDn    = f_new(nTPMaxDn)
eTPUp       = f_new(nTPUp)
eTPDn       = f_new(nTPDn)
eSkullUp    = f_new(nSkullUp)
eSkullDn    = f_new(nSkullDn)
eUltBuy     = f_new(nUltBuy)
eUltSell    = f_new(nUltSell)
eGapG       = f_new(nGapG)
eGapR       = f_new(nGapR)


// ==========================   VOLUME IMBALANCE LINES (drawn on Renko)  ================================

var line[] ll = array.new_line()
if array.size(ll) > 0
    for i = array.size(ll) - 1 to 0
        ln = array.get(ll, i)
        y = line.get_y1(ln)
        if high > y and low < y
            line.delete(ln)
            array.remove(ll, i)

if bTrackBar and eGapG and not na(qGapPxG)
    array.push(ll, line.new(bar_index, qGapPxG, bar_index + iBarExtend, qGapPxG, color=color.new(color.lime, 50), width=lWidth, style=sStyle, extend=bExtend))
if bTrackBar and eGapR and not na(qGapPxR)
    array.push(ll, line.new(bar_index, qGapPxR, bar_index + iBarExtend, qGapPxR, color=color.new(color.red, 50), width=lWidth, style=sStyle, extend=bExtend))
while array.size(ll) > 450
    line.delete(array.shift(ll))


// ==========================   CLOUD RENDER  ================================

// Smooth the 1m cloud values across bricks so gaps between brick timestamps don't make it jagged
sMG  = iCloudSmooth > 1 ? ta.ema(qMG, iCloudSmooth) : qMG
sFan = iCloudSmooth > 1 ? ta.ema(qFan, iCloudSmooth) : qFan
sSrc = iCloudSmooth > 1 ? ta.ema(qCloud, iCloudSmooth) : qCloud

float cMIN = cloudType=="Commodity Channel" ? 20 : 20
float cMID = cloudType=="Commodity Channel" ? -100 : 50
float cMAX = cloudType=="Commodity Channel" ? 100 : 80

color cColor = na
if sFan > sMG
    cColor := cloudType=="Simple" ? color.new(colorBigGreen, iSimpleCloud) : color.from_gradient(sSrc, cMID, cMAX, color.new(colorBigGreen, iLowCloud), color.new(colorBigGreen, iHighCloud))
else
    cColor := cloudType=="Simple" ? color.new(colorBigRed, iSimpleCloud) : color.from_gradient(sSrc, cMIN, cMID, color.new(colorBigRed, iLowCloud), color.new(colorBigRed, iHighCloud))

lineMD = plot(cloudType != "None" ? sMG : na, color=color.new(color.blue, 100), title="McGinley Dynamic")
FVMA = plot(cloudType != "None" ? sFan : na, color=color.new(color.white, 100), title="Bixord FVMA")
fill(FVMA, lineMD, color=cColor, title="Cloud")


// ==========================   PLOTS  ================================

plotchar(eBuyDot ? 1 : na, char=".", location=location.belowbar, color=colorBigGreen, size=size.tiny, title="Buy Signal")
plotchar(eSellDot ? 1 : na, char="•", location=location.abovebar, color=colorBigRed, size=size.tiny, title="Sell Signal")

plotchar(eStrongBuy ? 1 : na, char="➊", location=location.belowbar, color=colorBigGreen, size=size.tiny, title="Strong Buy Signal")
plotchar(eStrongSell ? 1 : na, char="➊", location=location.abovebar, color=colorBigRed, size=size.tiny, title="Strong Sell Signal")

plotchar(bShowPlus and ePlusG ? 1 : na, char="+", location=location.belowbar, color=colorBigGreen, size=size.tiny, title="Add Contract (Light)")
plotchar(bShowPlus and ePlusR ? 1 : na, char="+", location=location.abovebar, color=colorBigRed, size=size.tiny, title="Add Contract (Light)")

plotchar(bShowBigPlus and eVodkaB, char="✚", location=location.belowbar, size=size.tiny, color=colorBigGreen, title="Add Contract (Strong)")
plotchar(bShowBigPlus and eVodkaS, char="✚", location=location.abovebar, size=size.tiny, color=colorBigRed, title="Add Contract (Strong)")

plotchar(bShowProfit and eTPMaxUp, char="✔", location=location.abovebar, size=size.small, color=color.red, title="Take Partial Profit")
plotchar(bShowProfit and eTPMaxDn, char="✔", location=location.belowbar, size=size.small, color=color.red, title="Take Partial Profit")

plotchar(bShowProfit and eTPUp, char="✓", location=location.abovebar, size=size.small, color=color.purple, title="Take Full Profit")
plotchar(bShowProfit and eTPDn, char="✓", location=location.belowbar, size=size.small, color=color.purple, title="Take Full Profit")

plotshape(eSkullDn, style=shape.triangledown, location=location.abovebar, size=size.tiny, color=color.new(color.yellow, 20), title="9/21 EMA Cross")
plotshape(eSkullUp, style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.new(color.yellow, 20), title="9/21 EMA Cross")

plot(bShowHEMA ? qHema : na, title="HEMA", linewidth=1, color=color.new(color.fuchsia, 20))

plotcandle(sCandleType=="Vector" ? open : na, high, low, close, color=qPv, wickcolor=qPv, bordercolor=qPv, title="Vector Candles")
plotcandle(sCandleType=="Volume Delta" ? open : na, high, low, close, color=qCvdC, wickcolor=qCvdW, bordercolor=qCvdB, title="Volume Delta Candles")
plotcandle(sCandleType=="Waddah" ? open : na, high, low, close, "", color=qWaeB, wickcolor=qWaeW, bordercolor=qWaeBr, title="Waddah Explosion Candles")
plotcandle(sCandleType=="Squeeze" ? open : na, high, low, close, color=qSqC, wickcolor=qSqW, bordercolor=qSqB, title="Squeeze Momentum Candles")



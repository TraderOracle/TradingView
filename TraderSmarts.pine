//@version=5
indicator("TraderSmarts Lines", overlay=true, max_boxes_count=500, max_labels_count=500)

zones = input.text_area("", title="TraderSmarts Zones v2 — Paste Values Here", group="Data")

sFontSize   = input.string(title="Zone Label Font Size", options=["Tiny", "Small", "Normal", "Large"], defval="Normal", group="Zone Appearance")
lWidth      = input.int(1, title="Zone Border Width", minval=1, group="Zone Appearance")
iBoxTrans   = input.int(50, title="Zone Fill Transparency", minval=0, maxval=100, group="Zone Appearance")
sExtend     = input.string(title="Left Border Style", options=["None", "Left", "Both"], defval="Left", group="Zone Appearance", tooltip="Border-line style only. The shaded zone itself always grows forward with the chart, bar by bar, so it never trails behind price on any chart type (including Renko/Heikin-Ashi).")
iHistBars   = input.int(150, title="Zone Starting Width (bars back)", minval=1, group="Zone Appearance", tooltip="How far back the left edge of each zone starts. Purely cosmetic — the zone still extends forward automatically every bar.")

bShowMTS    = input.bool(true, title="Show MTS Zones", group="Zone Filters")
bShowTS     = input.bool(true, title="Show TS Zones", group="Zone Filters")

colLong  = input.color(color.rgb(8, 133, 8),    title="Long Zone Color",         group="Zone Colors")
colShort = input.color(color.rgb(130, 17, 17),  title="Short Zone Color",        group="Zone Colors")
colLIS   = input.color(color.rgb(206, 158, 14), title="Line-in-Sand Zone Color", group="Zone Colors")
colMTS   = input.color(color.yellow,            title="MTS Zone Color",          group="Zone Colors")
colTS    = input.color(color.rgb(62, 142, 209), title="TS Zone Color",           group="Zone Colors")

myFont = sFontSize == "Tiny" ? size.tiny : sFontSize == "Small" ? size.small : sFontSize == "Normal" ? size.normal : size.large

myExtend = sExtend == "Both" ? extend.both : sExtend == "Left" ? extend.left : extend.none

// Boxes are rebuilt only when the pasted text actually changes (see below).
// This is what was causing the flicker: the old script rebuilt boxes on the
// very first tick and then silently ignored the text box forever, but on
// Renko/Heikin-Ashi charts (which fully recompute their synthetic bars on
// almost every update) all `var` state resets on every recalculation, so the
// zones were being rebuilt from scratch repeatedly without ever deleting the
// previous set of boxes -- old and new boxes briefly overlapped/flashed.
var box[]    boxes      = array.new_box()
var string   sLastZones = ""

AlertParty(b) =>
    fBottom = b.get_bottom()
    fTop = b.get_top()
    bool bW = (close > open and high > fTop and close < fTop) or (close < open and low > fTop and open < fTop)
    bool bIn = (high > fTop and low < fTop and low > fBottom) or (low < fBottom and high < fTop and high > fBottom)
    [bW, bIn]

// A history-length-safe left anchor. The original used bar_index[100], which
// returns na (and crashes box.new) whenever fewer than 100 bars exist -- a
// state that Renko/Heikin-Ashi charts hit far more often than regular
// candles because they can rebuild their whole bar series on the fly.
leftBar() =>
    math.max(bar_index - iHistBars, 0)

drawRectangle(string s, string desc) =>
    bAlert = false
    string top = s
    string bottom = s

    if str.contains(s, "-")
        string s1 = str.replace_all(s, " - ", "-")
        string[] z = str.split(s1, "-")
        if array.size(z) > 1
            top := array.get(z, 1)
            bottom := array.get(z, 0)

    float fTop = str.tonumber(top)
    float fBot = str.tonumber(bottom)

    if not na(fTop) and not na(fBot) and fTop > 0 and fBot > 0
        color c = str.contains(desc, "Long") ? colLong :
                  str.contains(desc, "Short") ? colShort :
                  str.contains(desc, "Sand") ? colLIS :
                  str.contains(desc, "MTS") ? colMTS :
                  str.contains(desc, "TS") ? colTS : na

        if not na(c)
            box bahx = box.new(leftBar(), fTop, bar_index, fBot,
                 text_size=myFont, text=desc,
                 text_color=color.new(c, 0),
                 border_color=color.new(c, iBoxTrans),
                 bgcolor=color.new(c, iBoxTrans),
                 border_width=lWidth, extend=myExtend)
            array.push(boxes, bahx)
            [bW, bR] = AlertParty(bahx)
            bAlert := bW or bR
    bAlert

// --- Keep every zone's right edge glued to the current bar, every bar. ---
// This replaces relying on extend=both/right for the fill itself: Pine's
// `extend` only stretches the *border lines*, not the shaded background, so
// the old boxes visually stopped growing right after they were drawn and
// looked stale/cut off. Updating the right edge here keeps the shaded zone
// current on every bar, on any chart type.
if array.size(boxes) > 0
    for b in boxes
        b.set_right(bar_index)

bAlert = false
if barstate.islast and zones != sLastZones
    sLastZones := zones

    if array.size(boxes) > 0
        for b in boxes
            box.delete(b)
        array.clear(boxes)

    string[] _pair = str.split(zones, "\n")

    for s0 in _pair
        string s = str.trim(s0)
        if str.length(s) == 0
            continue

        string[] comma = str.split(s, ", ")

        if str.contains(s, "MTS Numbers: ") and bShowMTS
            // NQ MTS Numbers: 20463.75, 20196.25, 20048.50, 18263.00, 17962.50
            string digit = ""
            string desc = "MTS"
            string[] sb = str.split(s, ":")
            if array.size(sb) > 1
                string s1 = str.replace_all(array.get(sb, 1), " - ", "-")
                string[] sa = str.split(s1, ",")
                for a in sa
                    if str.contains(a, ".")
                        digit := str.trim(a)
                    if drawRectangle(digit, desc)
                        bAlert := true
        else if str.contains(s, "-")
            // 20129.00-23492.50 Range Short
            string digit = ""
            string desc = ""
            string s1 = str.replace_all(s, " - ", "-")
            string[] sa = str.split(s1, " ")
            for a in sa
                if str.length(a) > 0
                    if str.contains(a, "-")
                        digit := a
                    else
                        desc := desc + " " + a
            if drawRectangle(digit, desc)
                bAlert := true
        else if comma.size() > 40 and bShowTS
            // 20517.25, 20429.25, 20361.00, 20358.75, ...
            string[] sa = str.split(s, ",")
            for a in sa
                if drawRectangle(str.trim(a), "TS")
                    bAlert := true
        else
            // 20129.00 Range Short
            string digit = ""
            string desc = ""
            string[] sa = str.split(s, " ")
            for a in sa
                if str.length(a) > 0
                    if not na(str.tonumber(a))
                        digit := a
                    else
                        desc := desc + " " + a
            if drawRectangle(digit, desc)
                bAlert := true

alertcondition(bAlert, "TraderSmarts line alert")

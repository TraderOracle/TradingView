//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Zone & Line Bounce Engine  v6
//
//  Everything price can bounce off is a "Band" — a top and a bottom. Pasted
//  rectangles are real bands; the EMA, VWAP and session levels are bands with
//  top == bottom, widened only by the tolerance setting. One state machine
//  handles all of them. `useFar` is off for the lines because a zero-width
//  band has no far side, so those only ever produce wick or touch bounces.
//
//  Gates, in order:
//    READY     session levels stay dead until their session has closed
//    APPROACH  the N candles before first contact must travel toward the band
//    BOUNCE    price closes back out the side it came from
//    CONFIRM   the next N candles close further in the bounce direction
//
//  Session times are written in the timezone you pick below. Defaults are
//  US Central. CHANGE THE SESSION STRINGS if you change the timezone.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Zone & Line Bounce Engine v6", overlay = true,
     max_bars_back = 300, max_boxes_count = 500, max_labels_count = 500,
     max_lines_count = 50)

// ═══════════════════════════ INPUTS ═══════════════════════════
gT = "Timezone & sessions"
tz = input.string("America/Chicago", "Timezone", group = gT, options = [
     "America/Chicago", "America/New_York", "America/Denver", "America/Los_Angeles",
     "America/Sao_Paulo", "Europe/London", "Europe/Berlin", "Europe/Moscow",
     "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Tokyo",
     "Australia/Sydney", "UTC"],
     tooltip = "All session strings below are interpreted in this timezone. Defaults are written for America/Chicago (CST/CDT) — if you switch timezone, rewrite them to match.")
nySess   = input.session("0830-1500", "NY session",       group = gT, tooltip = "Anchors the VWAP at its first bar. CST default = 09:30–16:00 ET.")
orSess   = input.session("0830-0930", "1H opening range", group = gT, tooltip = "First hour of the NY session. CST default = 09:30–10:30 ET.")
asiaSess = input.session("1800-0300", "Asia session",     group = gT, tooltip = "CST default = 19:00–04:00 ET.")
lonSess  = input.session("0200-1030", "London session",   group = gT, tooltip = "CST default = 03:00–11:30 ET.")

gL = "Lines"
shEma  = input.bool(true, "EMA 200",          group = gL, inline = "ema")
cEma   = input.color(#E8E4D9, "",             group = gL, inline = "ema")
emaLen = input.int(200, "len", minval = 1,    group = gL, inline = "ema")
emaTr  = input.int(20, "Line transparency %", minval = 0, maxval = 100, group = gL,
     tooltip = "Applies to the EMA line only. Its bounce markers and title stay fully opaque.")
emaGap = input.int(2, "EMA dot spacing (bars)", minval = 1, maxval = 10, group = gL,
     tooltip = "1 = a dot on every bar. Raise it for a sparser dotted line.")
shVwp  = input.bool(true, "VWAP (NY anchor)",  group = gL, inline = "vwp")
cVwp   = input.color(#2E6FD9, "",              group = gL, inline = "vwp")
shOr   = input.bool(true, "1H opening range",  group = gL, inline = "or")
cOr    = input.color(#FFFFFF, "",              group = gL, inline = "or")
shAs   = input.bool(true, "Asia high / low",   group = gL, inline = "as")
cAs    = input.color(#7EC8E3, "",              group = gL, inline = "as")
shLn   = input.bool(true, "London high / low", group = gL, inline = "ln")
cLn    = input.color(#F5A9C4, "",              group = gL, inline = "ln")
extRt  = input.int(3, "Extend levels right (bars)", minval = 0, group = gL)

// ── Line titles ──
// Pine can only use the chart's system font or a monospace font — Arial is not
// selectable — and text size is an enum, not a point value. "Small" is the
// nearest equivalent to 9pt on a standard chart.
gN      = "Line titles"
lblOn   = input.bool(true, "Show titles at right of each line", group = gN)
lblPx   = input.bool(false, "Append the price", group = gN)
lblSzIn = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = gN,
     tooltip = "Pine has no numeric font sizes. Small ≈ 9pt on a default chart.")
lblFnIn = input.string("Default", "Font", options = ["Default", "Monospace"], group = gN,
     tooltip = "Only these two families exist in Pine. Default is the chart's own sans-serif.")
lblWtIn = input.string("Regular", "Weight", options = ["Regular", "Bold", "Italic"], group = gN)
lblOff  = input.int(4, "Title offset right (bars)", minval = 0, group = gN)

gZ = "Zones (pasted rectangles)"
shZn = input.bool(true, "Enable zones", group = gZ)
zonesStr = input.text_area(
     defval = "top,7747.88,bottom,7746.17,top,7765.05,bottom,7763.34,top,7786.07,bottom,7781.99,top,7820.84,bottom,7816.76,top,7831.17,bottom,7829.46",
     title  = "Rectangles", group = gZ,
     tooltip = "Format: top,<price>,bottom,<price>,...\nSpaces, tabs and line breaks are ignored.")
cZn = input.color(color.teal, "Zone colour", group = gZ)

gA       = "Approach"
prevN    = input.int(2, "Approach candles", minval = 0, maxval = 10, group = gA,
     tooltip = "Candles before first contact that must be travelling toward the band. 0 disables.")
apprMono = input.bool(true, "Every approach candle must move closer", group = gA)

gB       = "Bounce rules"
onlyDone = input.bool(true, "Session levels only signal once their session has closed", group = gB,
     tooltip = "A session high is meaningless while it is still being made — every new high touches it by definition.")
tol      = input.float(0.0, "Edge tolerance (price)", minval = 0, group = gB,
     tooltip = "Also sets the effective thickness of the single-price lines. 0 = exact touch.")
farPct   = input.float(80, "Far-side reach % (zones only)", minval = 1, maxval = 100, group = gB) / 100
maxSeq   = input.int(10, "Max bars inside band", minval = 1, group = gB)
cooldn   = input.int(0, "Cooldown bars per band", minval = 0, group = gB)

gC       = "Confirmation"
waitN    = input.int(1, "Wait candles", minval = 1, maxval = 5, group = gC)
needProg = input.bool(true, "Confirm close must beat the bounce candle's close", group = gC)
needBody = input.bool(false, "Confirm candle must close in the bounce direction", group = gC)
markBack = input.bool(true, "Draw marker on the bounce candle", group = gC)

gS     = "Signals"
useT1  = input.bool(true, "1 · Wick rejection (no body inside)", group = gS)
useT2  = input.bool(true, "2 · Touch & bounce",                  group = gS)
useT3  = input.bool(true, "3 · Back-of-zone bounce (zones only)", group = gS)
showLb = input.bool(true, "Signal labels", group = gS)

lblSz = lblSzIn == "Tiny" ? size.tiny : lblSzIn == "Small" ? size.small : lblSzIn == "Normal" ? size.normal : size.large
lblFn = lblFnIn == "Monospace" ? font.family_monospace : font.family_default
lblWt = lblWtIn == "Bold" ? text.format_bold : lblWtIn == "Italic" ? text.format_italic : text.format_none

// ════════════════════════ APPROACH FILTER ════════════════════════
// Called on the bar that first contacts a band. Offset 0 is that contact bar;
// offsets 1..prevN are the run-up. dir = 1 means price is falling toward the
// band from above, so we track lows; dir = -1 tracks highs.
approaching(int dir) =>
    bool ok = true
    if prevN > 0
        if bar_index < prevN + 1
            ok := false
        else
            if apprMono
                for i = 0 to prevN - 1
                    newer = dir == 1 ? low[i]     : high[i]
                    older = dir == 1 ? low[i + 1] : high[i + 1]
                    if dir == 1 and newer > older
                        ok := false
                    if dir == -1 and newer < older
                        ok := false
            netNew = dir == 1 ? low[0]     : high[0]
            netOld = dir == 1 ? low[prevN] : high[prevN]
            if dir == 1 and netNew >= netOld
                ok := false
            if dir == -1 and netNew <= netOld
                ok := false
    ok

// ═════════════════════════ BAND OBJECT ═════════════════════════
type Band
    string name
    string abbr
    color  col
    bool   useFar  = false
    box    bx      = na
    float  fTop    = na      // fixed top/bottom, used by pasted zones only
    float  fBot    = na
    int    side    = 0       // +1 price above band, -1 below, 0 unknown
    bool   active  = false
    int    origin  = 0
    bool   appr    = false
    bool   bodyIn  = false
    bool   farHit  = false
    int    start   = 0
    int    lastSig = -100000
    int    pKind   = 0       // pending type, 0 = nothing armed
    int    pDir    = 0
    int    pBar    = 0
    float  pRef    = na
    int    fired   = 0       // this bar's confirmed signal, 0 = none
    int    fdir    = 0

// One machine for zones and lines. Pass t == b for a single-price level.
// Passing na parks the band: state clears and nothing can fire.
method step(Band this, float t, float b) =>
    this.fired := 0
    this.fdir  := 0
    if na(t) or na(b)
        this.side   := 0
        this.active := false
        this.pKind  := 0
    else
        zt     = math.max(t, b)
        zb     = math.min(t, b)
        depth  = math.max(zt - zb, syminfo.mintick)
        hitZ   = low <= zt + tol and high >= zb - tol
        cAbove = close > zt + tol
        cBelow = close < zb - tol

        // ── 1. resolve anything pending, before new interactions ──
        if this.pKind != 0
            stillOut = this.pDir == 1 ? cAbove : cBelow
            if not stillOut
                this.pKind := 0                 // fell back in, void
            else if bar_index - this.pBar >= waitN
                prog = not needProg or (this.pDir == 1 ? close > this.pRef : close < this.pRef)
                body = not needBody or (this.pDir == 1 ? close > open      : close < open)
                if prog and body and bar_index - this.lastSig >= cooldn
                    this.fired   := this.pKind
                    this.fdir    := this.pDir
                    this.lastSig := bar_index
                this.pKind := 0

        // ── 2. track the interaction ──
        if not hitZ
            this.side   := close > zt ? 1 : -1
            this.active := false
            this.bodyIn := false
            this.farHit := false
        else
            if not this.active
                this.active := true
                this.origin := this.side != 0 ? this.side : (close > zt ? 1 : -1)
                this.appr   := approaching(this.origin)
                this.bodyIn := false
                this.farHit := false
                this.start  := bar_index
            bh = math.max(open, close)
            bl = math.min(open, close)
            if bl <= zt and bh >= zb
                this.bodyIn := true
            if this.useFar
                if this.origin == 1 and low <= zb + depth * (1 - farPct) + tol
                    this.farHit := true
                if this.origin == -1 and high >= zt - depth * (1 - farPct) - tol
                    this.farHit := true

            bounced = (this.origin ==  1 and cAbove) or (this.origin == -1 and cBelow)
            broke   = (this.origin ==  1 and cBelow) or (this.origin == -1 and cAbove)

            // ── 3. arm, don't fire ──
            if bounced or broke
                if bounced and this.appr and bar_index - this.start <= maxSeq
                    kind = this.farHit ? 3 : this.bodyIn ? 2 : 1
                    on   = kind == 1 ? useT1 : kind == 2 ? useT2 : useT3
                    if on
                        this.pKind := kind
                        this.pDir  := this.origin
                        this.pBar  := bar_index
                        this.pRef  := close
                this.active := false
                this.side   := cAbove ? 1 : -1
    this.fired

method bull(Band this) => this.fired != 0 and this.fdir ==  1
method bear(Band this) => this.fired != 0 and this.fdir == -1
method hit (Band this) => this.fired != 0

method kindTxt(Band this) =>
    this.fired == 1 ? "wick" : this.fired == 2 ? "touch" : "back"

method desc(Band this) =>
    string out = ""
    if this.fired != 0
        out := this.name + " " + this.kindTxt() + " " + (this.fdir == 1 ? "up" : "down")
    out

method tagTxt(Band this) =>
    string out = ""
    if this.fired != 0
        out := this.abbr + (this.fdir == 1 ? "▲" : "▼")
    out

joinTxt(string acc, string s, string sep) =>
    string out = acc
    if str.length(s) > 0
        out := str.length(acc) == 0 ? s : acc + sep + s
    out

// ═══════════════════════ LEVEL SOURCES ═══════════════════════
inSess(string s) => not na(time(timeframe.period, s, tz))

nyOn   = inSess(nySess)
orOn   = inSess(orSess)
asiaOn = inSess(asiaSess)
lonOn  = inSess(lonSess)

nyStart   = nyOn   and not nyOn[1]
orStart   = orOn   and not orOn[1]
asiaStart = asiaOn and not asiaOn[1]
lonStart  = lonOn  and not lonOn[1]

ema200 = ta.ema(close, emaLen)
vwp    = ta.vwap(hlc3, nyStart)

// Session extremes. Each holds after its session closes, until the next opens.
// `started` is passed in rather than derived from on[1] inside the function,
// so no parameter history is needed.
sessHL(bool on, bool started, float prevH, float prevL) =>
    float h = prevH
    float l = prevL
    if started
        h := high
        l := low
    else if on
        h := math.max(prevH, high)
        l := math.min(prevL, low)
    [h, l]

var float orH = na
var float orL = na
var int   orX = na
var float asH = na
var float asL = na
var int   asX = na
var float lnH = na
var float lnL = na
var int   lnX = na

[orH2, orL2] = sessHL(orOn,   orStart,   orH, orL)
[asH2, asL2] = sessHL(asiaOn, asiaStart, asH, asL)
[lnH2, lnL2] = sessHL(lonOn,  lonStart,  lnH, lnL)
orH := orH2
orL := orL2
asH := asH2
asL := asL2
lnH := lnH2
lnL := lnL2

if orStart
    orX := bar_index
if asiaStart
    asX := bar_index
if lonStart
    lnX := bar_index

// ── READY GATE ──
// A session level is only tradeable once the session that made it is over.
// While the session runs, the high is still being printed, so every new high
// "touches" it by construction and the machine would fire constantly.
orReady = not na(orH) and (not onlyDone or not orOn)
asReady = not na(asH) and (not onlyDone or not asiaOn)
lnReady = not na(lnH) and (not onlyDone or not lonOn)

// ══════════════════════════ DRAWING ══════════════════════════
// plot() has no dotted style, so the EMA is drawn as spaced circles.
emaCol  = color.new(cEma, emaTr)
emaDots = bar_index % emaGap == 0 ? ema200 : na
plot(shEma ? emaDots : na, "EMA 200", color = emaCol, linewidth = 3, style = plot.style_circles)
plot(shVwp ? vwp : na, "VWAP (NY)", color = cVwp, linewidth = 3)

var line lnOrH = line.new(0, 0, 0, 0, width = 1, style = line.style_dotted)
var line lnOrL = line.new(0, 0, 0, 0, width = 1, style = line.style_dotted)
var line lnAsH = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnAsL = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnLnH = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnLnL = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)

drawLvl(line ln, float lvl, int x1, color col, bool show) =>
    if na(lvl) or na(x1) or not show
        line.set_color(ln, color.new(color.black, 100))
    else
        line.set_color(ln, col)
        line.set_xy1(ln, x1, lvl)
        line.set_xy2(ln, bar_index + extRt, lvl)

drawLvl(lnOrH, orH, orX, cOr, shOr)
drawLvl(lnOrL, orL, orX, cOr, shOr)
drawLvl(lnAsH, asH, asX, cAs, shAs)
drawLvl(lnAsL, asL, asX, cAs, shAs)
drawLvl(lnLnH, lnH, lnX, cLn, shLn)
drawLvl(lnLnL, lnL, lnX, cLn, shLn)

// ═══════════════════════ LINE TITLES ═══════════════════════
// style_label_left puts the anchor on the text's LEFT edge, so the text sits
// to the right of the point and is vertically centred on it. A fully
// transparent background leaves only the text visible.
//
// These are rebuilt on every last bar rather than created once at bar 0.
// Pine keeps only the newest max_labels_count labels — anything older is
// garbage-collected — so titles created on the first bar would be the first
// things deleted once signal labels accumulate.
titleLbl(label old, string txt, float lvl, bool show, color col) =>
    if not na(old)
        label.delete(old)
    label out = na
    if lblOn and show and not na(lvl)
        full = txt + (lblPx ? "  " + str.tostring(lvl, format.mintick) : "")
        out := label.new(bar_index + lblOff, lvl, full,
             style            = label.style_label_left,
             color            = color.new(color.black, 100),
             textcolor        = col,
             size             = lblSz,
             text_font_family = lblFn,
             text_formatting  = lblWt,
             textalign        = text.align_left)
    out

var label tEma = na
var label tVwp = na
var label tOrH = na
var label tOrL = na
var label tAsH = na
var label tAsL = na
var label tLnH = na
var label tLnL = na

if barstate.islast
    tEma := titleLbl(tEma, "EMA " + str.tostring(emaLen), ema200, shEma, cEma)
    tVwp := titleLbl(tVwp, "VWAP",        vwp, shVwp, cVwp)
    tOrH := titleLbl(tOrH, "OR High",     orH, shOr,  cOr)
    tOrL := titleLbl(tOrL, "OR Low",      orL, shOr,  cOr)
    tAsH := titleLbl(tAsH, "Asia High",   asH, shAs,  cAs)
    tAsL := titleLbl(tAsL, "Asia Low",    asL, shAs,  cAs)
    tLnH := titleLbl(tLnH, "London High", lnH, shLn,  cLn)
    tLnL := titleLbl(tLnL, "London Low",  lnL, shLn,  cLn)

// ════════════════════════ BAND REGISTRY ════════════════════════
var Band bEma = Band.new(name = "EMA 200",     abbr = "EMA", col = cEma)
var Band bVwp = Band.new(name = "VWAP",        abbr = "VW",  col = cVwp)
var Band bOrH = Band.new(name = "OR High",     abbr = "ORH", col = cOr)
var Band bOrL = Band.new(name = "OR Low",      abbr = "ORL", col = cOr)
var Band bAsH = Band.new(name = "Asia High",   abbr = "ASH", col = cAs)
var Band bAsL = Band.new(name = "Asia Low",    abbr = "ASL", col = cAs)
var Band bLnH = Band.new(name = "London High", abbr = "LNH", col = cLn)
var Band bLnL = Band.new(name = "London Low",  abbr = "LNL", col = cLn)

var array<Band> zoneBands = array.new<Band>()
var array<Band> allBands  = array.new<Band>()

parseZones(string src) =>
    tops  = array.new<float>()
    bots  = array.new<float>()
    clean = str.replace_all(str.replace_all(str.replace_all(src, " ", ""), "\n", ""), "\t", "")
    string key = "top"
    float  pT  = na
    float  pB  = na
    for tk in str.split(clean, ",")
        if str.length(tk) > 0
            n = str.tonumber(tk)
            if na(n)
                key := str.lower(tk)
            else
                if str.startswith(key, "b")
                    pB := n
                else
                    pT := n
                if not na(pT) and not na(pB)
                    array.push(tops, math.max(pT, pB))
                    array.push(bots, math.min(pT, pB))
                    pT := na
                    pB := na
    [tops, bots]

if barstate.isfirst
    array.push(allBands, bEma)
    array.push(allBands, bVwp)
    array.push(allBands, bOrH)
    array.push(allBands, bOrL)
    array.push(allBands, bAsH)
    array.push(allBands, bAsL)
    array.push(allBands, bLnH)
    array.push(allBands, bLnL)
    if shZn
        [tops, bots] = parseZones(zonesStr)
        if array.size(tops) > 0
            for i = 0 to array.size(tops) - 1
                zt = array.get(tops, i)
                zb = array.get(bots, i)
                bx = box.new(time, zt, time + 1, zb, xloc = xloc.bar_time,
                     extend = extend.both, bgcolor = color.new(cZn, 88),
                     border_color = color.new(cZn, 35), border_width = 1)
                bd = Band.new(name = "Zone " + str.tostring(zb, format.mintick),
                     abbr = "Z", col = cZn, useFar = true, bx = bx, fTop = zt, fBot = zb)
                array.push(zoneBands, bd)
                array.push(allBands, bd)

// ════════════════════════ RUN THE MACHINE ════════════════════════
emaSrc = shEma ? ema200 : na
vwpSrc = shVwp ? vwp : na
orHSrc = shOr and orReady ? orH : na
orLSrc = shOr and orReady ? orL : na
asHSrc = shAs and asReady ? asH : na
asLSrc = shAs and asReady ? asL : na
lnHSrc = shLn and lnReady ? lnH : na
lnLSrc = shLn and lnReady ? lnL : na

bEma.step(emaSrc, emaSrc)
bVwp.step(vwpSrc, vwpSrc)
bOrH.step(orHSrc, orHSrc)
bOrL.step(orLSrc, orLSrc)
bAsH.step(asHSrc, asHSrc)
bAsL.step(asLSrc, asLSrc)
bLnH.step(lnHSrc, lnHSrc)
bLnL.step(lnLSrc, lnLSrc)

for bd in zoneBands
    bd.step(bd.fTop, bd.fBot)

// ════════════════════════ AGGREGATE ════════════════════════
zBull = false
zBear = false
for bd in zoneBands
    zBull := zBull or bd.bull()
    zBear := zBear or bd.bear()

emaBull = bEma.bull()
emaBear = bEma.bear()
vwpBull = bVwp.bull()
vwpBear = bVwp.bear()
orBull  = bOrH.bull() or bOrL.bull()
orBear  = bOrH.bear() or bOrL.bear()
asBull  = bAsH.bull() or bAsL.bull()
asBear  = bAsH.bear() or bAsL.bear()
lnBull  = bLnH.bull() or bLnL.bull()
lnBear  = bLnH.bear() or bLnL.bear()

string note = ""
string tag  = ""
for bd in allBands
    note := joinTxt(note, bd.desc(),   "  |  ")
    tag  := joinTxt(tag,  bd.tagTxt(), " ")

anyBull = emaBull or vwpBull or orBull or asBull or lnBull or zBull
anyBear = emaBear or vwpBear or orBear or asBear or lnBear or zBear

// ════════════════════════ MARKERS ════════════════════════
// One colour per line family, shape carries direction. Markers sit back on
// the bounce candle; the alert still fires on the confirmation bar.
mkOff = markBack ? -waitN : 0
lbOff = markBack ?  waitN : 0

plotshape(emaBull, "EMA bounce up",      shape.triangleup,   location.belowbar, cEma, size = size.tiny, offset = mkOff)
plotshape(emaBear, "EMA bounce down",    shape.triangledown, location.abovebar, cEma, size = size.tiny, offset = mkOff)
plotshape(vwpBull, "VWAP bounce up",     shape.triangleup,   location.belowbar, cVwp, size = size.tiny, offset = mkOff)
plotshape(vwpBear, "VWAP bounce down",   shape.triangledown, location.abovebar, cVwp, size = size.tiny, offset = mkOff)
plotshape(orBull,  "OR bounce up",       shape.triangleup,   location.belowbar, cOr,  size = size.tiny, offset = mkOff)
plotshape(orBear,  "OR bounce down",     shape.triangledown, location.abovebar, cOr,  size = size.tiny, offset = mkOff)
plotshape(asBull,  "Asia bounce up",     shape.triangleup,   location.belowbar, cAs,  size = size.tiny, offset = mkOff)
plotshape(asBear,  "Asia bounce down",   shape.triangledown, location.abovebar, cAs,  size = size.tiny, offset = mkOff)
plotshape(lnBull,  "London bounce up",   shape.triangleup,   location.belowbar, cLn,  size = size.tiny, offset = mkOff)
plotshape(lnBear,  "London bounce down", shape.triangledown, location.abovebar, cLn,  size = size.tiny, offset = mkOff)
plotshape(zBull,   "Zone bounce up",     shape.diamond,      location.belowbar, cZn,  size = size.tiny, offset = mkOff)
plotshape(zBear,   "Zone bounce down",   shape.diamond,      location.abovebar, cZn,  size = size.tiny, offset = mkOff)

if showLb and (anyBull or anyBear)
    label.new(bar_index - lbOff, anyBull ? low[lbOff] : high[lbOff], tag,
         style     = anyBull ? label.style_label_up : label.style_label_down,
         color     = color.new(anyBull ? color.green : color.red, 25),
         textcolor = color.white, size = size.tiny, tooltip = note)

// ════════════════════════ ALERTS ════════════════════════
// One condition per line, either direction, any bounce type. Pick the one you
// want when creating the alert. The dynamic alert() carries the full detail
// but only fires under "Any alert() function call", which covers every band.
sEma = bEma.hit()
sVwp = bVwp.hit()
sOrH = bOrH.hit()
sOrL = bOrL.hit()
sAsH = bAsH.hit()
sAsL = bAsL.hit()
sLnH = bLnH.hit()
sLnL = bLnL.hit()
sZn  = zBull or zBear
sAny = anyBull or anyBear

alertcondition(sEma, "EMA 200 bounce",     "EMA 200 bounce")
alertcondition(sVwp, "VWAP bounce",        "NY VWAP bounce")
alertcondition(sOrH, "1H OR High bounce",  "1H opening range high bounce")
alertcondition(sOrL, "1H OR Low bounce",   "1H opening range low bounce")
alertcondition(sAsH, "Asia High bounce",   "Asia session high bounce")
alertcondition(sAsL, "Asia Low bounce",    "Asia session low bounce")
alertcondition(sLnH, "London High bounce", "London session high bounce")
alertcondition(sLnL, "London Low bounce",  "London session low bounce")
alertcondition(sZn,  "Zone bounce",        "Pasted zone bounce")
alertcondition(sAny, "Any line or zone bounce", "Confirmed bounce")

if sAny
    alert(syminfo.ticker + " " + timeframe.period + "  " + note, alert.freq_once_per_bar)

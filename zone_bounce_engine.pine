//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Zone & Line Bounce Engine  v9
//
//  TWO ENGINES SHARING ONE SET OF LEVELS
//
//  A) BOUNCE / SWEEP — every level is a "Band" (a top and a bottom). Pasted
//     ranges are real bands; the EMA, VWAP and session levels are bands with
//     top == bottom, widened by the tolerance setting. One state machine:
//       1  WICK   wick pierced an edge, no candle body ever inside
//       2  TOUCH  body dipped in, closed back out the same side
//       3  BACK   traversed to the far edge, rejected there, exited same side
//       4  SWEEP  closed clean through, lingered ≤ X candles, closed back
//
//  B) LFFC — level → FVG → fill → continuation. A four-stage setup:
//       1  price touches a level or zone
//       2  within N bars an FVG prints in the rejection direction
//       3  price returns and fills that gap
//       4  price closes back through the gap → signal  (type 5)
//
//  The two run independently. A fails-fast rejection fires A; a rejection that
//  builds structure and retests fires B. Both can fire on the same level.
//
//  Session times are written in the timezone you pick below. Defaults are
//  US Central. CHANGE THE SESSION STRINGS if you change the timezone.
// ═══════════════════════════════════════════════════════════════════════════
indicator("TO Bounce Engine", "TO Bounce Engine", overlay = true,
     max_bars_back = 300, max_boxes_count = 500, max_labels_count = 500,
     max_lines_count = 500)

// ═══════════════════════════ INPUTS ═══════════════════════════
gT = "Timezone & sessions"
tz = input.string("America/Chicago", "Timezone", group = gT, options = [
     "America/Chicago", "America/New_York", "America/Denver", "America/Los_Angeles",
     "America/Sao_Paulo", "Europe/London", "Europe/Berlin", "Europe/Moscow",
     "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Tokyo",
     "Australia/Sydney", "UTC"],
     tooltip = "All session strings below are interpreted in this timezone. Defaults are written for America/Chicago (CST/CDT) — if you switch timezone, rewrite them to match.")
nySess   = input.session("0830-1500", "NY session",       group = gT, tooltip = "Anchors the VWAP at its first bar. CST default = 09:30–16:00 ET.")
orSess   = input.session("0830-0930", "1H opening range", group = gT, tooltip = "First hour of the NY session. CST default = 09:30–10:30 ET.")
asiaSess = input.session("1800-0300", "Asia session",     group = gT, tooltip = "CST default = 19:00–04:00 ET.")
lonSess  = input.session("0200-1030", "London session",   group = gT, tooltip = "CST default = 03:00–11:30 ET.")

gL = "Lines"
shEma  = input.bool(true, "EMA 200",          group = gL, inline = "ema")
cEma   = input.color(#E8E4D9, "",             group = gL, inline = "ema")
emaLen = input.int(200, "len", minval = 1,    group = gL, inline = "ema")
emaTr  = input.int(20, "Line transparency %", minval = 0, maxval = 100, group = gL)
emaGap = input.int(2, "EMA dot spacing (bars)", minval = 1, maxval = 10, group = gL)
shVwp  = input.bool(true, "VWAP (NY anchor)",  group = gL, inline = "vwp")
cVwp   = input.color(#2E6FD9, "",              group = gL, inline = "vwp")
shOr   = input.bool(true, "1H opening range",  group = gL, inline = "or")
cOr    = input.color(#FFFFFF, "",              group = gL, inline = "or")
shAs   = input.bool(true, "Asia high / low",   group = gL, inline = "as")
cAs    = input.color(#7EC8E3, "",              group = gL, inline = "as")
shLn   = input.bool(true, "London high / low", group = gL, inline = "ln")
cLn    = input.color(#F5A9C4, "",              group = gL, inline = "ln")
extRt  = input.int(3, "Extend levels right (bars)", minval = 0, group = gL)

// ═══════════════ PASTED LEVELS & ZONES ═══════════════
// One text area for the bulk paste, three single-line fields for one-offs.
// All four are parsed into the same pool and feed BOTH engines.
gP = "Pasted levels & zones"
tipTxt = "Three formats, mixable, one entry per line.\n\n" +
     "A) price or price range, then name (spaces):\n" +
     "7714.00 - 7702.75 Extreme Short\n" +
     "7606.75 Line in the Sand\n\n" +
     "B) name/price pairs (commas):\n" +
     "vix r1, 29402, vix r2, 29417, VAH, 29488\n\n" +
     "C) top/bottom pairs (commas):\n" +
     "top,7747.88,bottom,7746.17,top,7765.05,bottom,7763.34\n\n" +
     "Ranges and top/bottom pairs become zones, single numbers become lines. " +
     "Anything before a ':' is a ticker tag and is ignored. Header lines with " +
     "nothing after the ':' are skipped. Duplicate names are auto-numbered. " +
     "';' also works as a line break."
useCust = input.bool(true, "Enable pasted levels", group = gP)
txtA    = input.text_area(
     "top,7747.88,bottom,7746.17,top,7765.05,bottom,7763.34",
     "Paste block", tooltip = tipTxt, group = gP)
lvl1 = input.string("", "Level 1", tooltip = tipTxt, group = gP)
lvl2 = input.string("", "Level 2", tooltip = tipTxt, group = gP)
lvl3 = input.string("", "Level 3", tooltip = tipTxt, group = gP)
matchSym = input.bool(false, "Only use lines whose ticker tag matches this chart", group = gP)
drawCust = input.bool(true, "Draw pasted levels", group = gP)
cCust    = input.color(color.new(color.teal, 20), "    Line / border", group = gP)
cCustBg  = input.color(color.new(color.teal, 88), "    Zone fill", group = gP)
custSty  = input.string("Dotted", "    Line style", options = ["Solid", "Dashed", "Dotted"], group = gP)

// ── Line titles ──
// Pine can only use the chart's system font or a monospace font — Arial is not
// selectable — and text size is an enum, not a point value.
gN      = "Line titles"
lblOn   = input.bool(true, "Show titles at right of each line", group = gN)
lblPx   = input.bool(false, "Append the price", group = gN)
lblSzIn = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = gN,
     tooltip = "Pine has no numeric font sizes. Small ≈ 9pt on a default chart.")
lblFnIn = input.string("Default", "Font", options = ["Default", "Monospace"], group = gN)
lblWtIn = input.string("Regular", "Weight", options = ["Regular", "Bold", "Italic"], group = gN)
lblOff  = input.int(4, "Title offset right (bars)", minval = 0, group = gN)

gA       = "Approach"
prevN    = input.int(2, "Approach candles", minval = 0, maxval = 10, group = gA,
     tooltip = "Candles before first contact that must be travelling toward the band. 0 disables.")
apprMono = input.bool(true, "Every approach candle must move closer", group = gA)

gB       = "Bounce rules"
onlyDone = input.bool(true, "Session levels only signal once their session has closed", group = gB,
     tooltip = "A session high is meaningless while it is still being made — every new high touches it by definition.")
tol      = input.float(0.0, "Edge tolerance (price)", minval = 0, group = gB,
     tooltip = "Also sets the effective thickness of the single-price lines. 0 = exact touch.")
farPct   = input.float(80, "Far-side reach % (zones only)", minval = 1, maxval = 100, group = gB) / 100
maxSeq   = input.int(10, "Max bars inside band", minval = 1, group = gB)
cooldn   = input.int(0, "Cooldown bars per band", minval = 0, group = gB)

gW       = "Sweep"
sweepMax = input.int(2, "Max candles beyond the band", minval = 1, maxval = 20, group = gW,
     tooltip = "How long price may hold past the level before the reclaim stops counting as a sweep. The breaking candle is the first one.")

// ═══════════ LFFC: LEVEL → FVG → FILL → CONTINUATION ═══════════
gF       = "FVG continuation"
atrLen   = input.int(14, "ATR length", minval = 1, group = gF)
fTolMode = input.string("ATR", "Touch tolerance", options = ["ATR", "Ticks", "None"], group = gF)
fTolAtr  = input.float(0.10, "    ATR multiple", step = 0.05, minval = 0, group = gF)
fTolTick = input.int(4, "    Ticks", minval = 0, group = gF)
fCool    = input.int(10, "Bars before the same level can re-arm", minval = 1, group = gF)
minLag   = input.int(1, "Min bars from touch to FVG", minval = 0, group = gF)
maxLag   = input.int(4, "Max bars from touch to FVG", minval = 1, group = gF)
minGap   = input.float(0.10, "Min gap size (× ATR)", step = 0.05, minval = 0, group = gF)
minDisp  = input.float(0.60, "Min displacement body (× ATR)", step = 0.10, minval = 0, group = gF)
needRej  = input.bool(true, "FVG must reject the level (close clear of the zone)", group = gF)
fillMode = input.string("Full (far edge)", "Fill requirement",
     options = ["Touch (near edge)", "50% (CE)", "Full (far edge)"], group = gF)
maxFill  = input.int(30, "Max bars to fill the gap", minval = 1, group = gF)
confMode = input.string("Close back through gap", "Continuation confirmation",
     options = ["Close back through gap", "Close beyond FVG bar extreme"], group = gF)
maxConf  = input.int(15, "Max bars to confirm after the fill", minval = 1, group = gF)
invBuf   = input.float(0.15, "Invalidation buffer beyond gap (× ATR)", step = 0.05, minval = 0, group = gF)
oneADay  = input.bool(false, "Only one signal per level per day", group = gF)
showFvg  = input.bool(true, "Draw FVG boxes", group = gF)
cFvgB    = input.color(color.new(color.teal, 75), "    Bull FVG fill", group = gF)
cFvgS    = input.color(color.new(color.red, 75),  "    Bear FVG fill", group = gF)

gC       = "Confirmation"
waitN    = input.int(1, "Wait candles", minval = 1, maxval = 5, group = gC)
needProg = input.bool(true, "Confirm close must beat the signal candle's close", group = gC)
needBody = input.bool(false, "Confirm candle must close in the signal direction", group = gC)
markBack = input.bool(true, "Draw marker on the signal candle", group = gC)

gS     = "Signals"
useT1  = input.bool(true, "1 · Wick rejection (no body inside)", group = gS)
useT2  = input.bool(true, "2 · Touch & bounce",                  group = gS)
useT3  = input.bool(true, "3 · Back-of-zone bounce (zones only)", group = gS)
useT4  = input.bool(true, "4 · Sweep (failed break, reclaimed)",  group = gS)
useT5  = input.bool(true, "5 · FVG continuation (level → FVG → fill)", group = gS)
showLb = input.bool(true, "Signal labels", group = gS)

lblSz = lblSzIn == "Tiny" ? size.tiny : lblSzIn == "Small" ? size.small : lblSzIn == "Normal" ? size.normal : size.large
lblFn = lblFnIn == "Monospace" ? font.family_monospace : font.family_default
lblWt = lblWtIn == "Bold" ? text.format_bold : lblWtIn == "Italic" ? text.format_italic : text.format_none

// ════════════════════════ LEVEL PARSER ════════════════════════
var array<string> pNames = array.new<string>()
var array<float>  pTops  = array.new<float>()
var array<float>  pBots  = array.new<float>()

// Pine functions cannot assign to globals, so the zone counter lives in a
// one-element array — arrays are passed by reference, so the function can
// bump it and the count survives across all four input fields.
var array<int> zoneSeq = array.new<int>(1, 0)

// Only these exact words trigger top/bottom pairing. Everything else is
// treated as a level name, so "Top of range, 7750" still works as format B.
isTopKey(string k) =>
    kk = str.lower(str.trim(k))
    kk == "top" or kk == "t" or kk == "hi" or kk == "high"

isBotKey(string k) =>
    kk = str.lower(str.trim(k))
    kk == "bottom" or kk == "bot" or kk == "b" or kk == "low" or kk == "lo"

addParsed(array<string> outN, array<float> outT, array<float> outB, string nm, float a, float b) =>
    base = str.length(str.trim(nm)) == 0 ? "LVL" : str.trim(nm)
    string fin = base
    int    k   = 2
    while outN.includes(fin)
        fin := base + " (" + str.tostring(k) + ")"
        k   += 1
    outN.push(fin)
    outT.push(math.max(a, b))
    outB.push(math.min(a, b))
    0

parseLevels(string src, array<string> outN, array<float> outT, array<float> outB, array<int> zSeq, bool matchTicker) =>
    // Pending halves of a legacy top/bottom pair. Declared at function scope
    // so a pair can straddle a line break as well as sitting on one line.
    float pTop = na
    float pBot = na
    clean = str.replace_all(src, "\r", "\n")
    clean := str.replace_all(clean, ";", "\n")
    clean := str.replace_all(clean, "–", "-")
    clean := str.replace_all(clean, "—", "-")
    if str.length(str.trim(clean)) > 0
        lines = str.split(clean, "\n")
        for li = 0 to lines.size() - 1
            ln = str.trim(lines.get(li))
            if str.length(ln) > 0
                string payload = ln
                bool   use     = true
                ci = str.pos(ln, ":")
                if not na(ci)
                    pre     = str.trim(str.substring(ln, 0, ci))
                    payload := str.trim(str.substring(ln, ci + 1))
                    if matchTicker and str.length(payload) > 0
                        tag = str.replace_all(str.replace_all(pre, "$", ""), "!", "")
                        use := str.length(tag) >= 2 and
                             str.lower(str.substring(tag, 0, 2)) == str.lower(str.substring(syminfo.ticker, 0, 2))

                // ── format B: comma-separated name / price pairs ──
                // Also carries the legacy "top,<price>,bottom,<price>" stream.
                // Those two keywords are held back and paired into a single
                // zone rather than becoming two levels literally called "top"
                // and "bottom".
                if use and str.length(payload) > 0 and str.contains(payload, ",")
                    toks = str.split(payload, ",")
                    string buf = ""
                    for ti = 0 to toks.size() - 1
                        tk = str.trim(toks.get(ti))
                        if str.length(tk) > 0
                            num = str.tonumber(tk)
                            float rt = na
                            float rb = na
                            if na(num) and str.contains(tk, "-")
                                dp = str.pos(tk, "-")
                                a  = str.tonumber(str.trim(str.substring(tk, 0, dp)))
                                b  = str.tonumber(str.trim(str.substring(tk, dp + 1)))
                                if not na(a) and not na(b)
                                    rt := a
                                    rb := b
                            if not na(num)
                                if isTopKey(buf)
                                    // a second top with no bottom between them
                                    // means the first was really a lone level
                                    if not na(pTop)
                                        addParsed(outN, outT, outB, "Level", pTop, pTop)
                                    pTop := num
                                else if isBotKey(buf)
                                    if not na(pBot)
                                        addParsed(outN, outT, outB, "Level", pBot, pBot)
                                    pBot := num
                                else
                                    addParsed(outN, outT, outB, buf, num, num)
                                buf := ""
                                if not na(pTop) and not na(pBot)
                                    zSeq.set(0, zSeq.get(0) + 1)
                                    addParsed(outN, outT, outB, "Zone " + str.tostring(zSeq.get(0)), pTop, pBot)
                                    pTop := na
                                    pBot := na
                            else if not na(rt)
                                addParsed(outN, outT, outB, buf, rt, rb)
                                buf := ""
                            else
                                buf := str.length(buf) == 0 ? tk : buf + " " + tk

                // ── format A: "price [- price] name" ──
                else if use and str.length(payload) > 0
                    p    = str.replace_all(payload, "-", " - ")
                    toks = str.split(p, " ")
                    float n1   = na
                    float n2   = na
                    bool  dash = false
                    int   nameStart = toks.size()
                    for ti = 0 to toks.size() - 1
                        tk = str.trim(toks.get(ti))
                        if str.length(tk) > 0
                            if tk == "-"
                                if na(n1) or not na(n2)
                                    nameStart := ti
                                    break
                                dash := true
                            else
                                v = str.tonumber(tk)
                                if na(v) or (not na(n1) and not dash) or not na(n2)
                                    nameStart := ti
                                    break
                                if na(n1)
                                    n1 := v
                                else
                                    n2 := v
                    string nm = ""
                    if nameStart < toks.size()
                        for ti = nameStart to toks.size() - 1
                            tk = str.trim(toks.get(ti))
                            if str.length(tk) > 0
                                nm := str.length(nm) == 0 ? tk : nm + " " + tk
                    if not na(n1)
                        addParsed(outN, outT, outB, nm, n1, na(n2) ? n1 : n2)
    // An unpaired half is a lone price, not half a zone — emit it rather than
    // dropping it silently.
    if not na(pTop)
        addParsed(outN, outT, outB, "Level", pTop, pTop)
    if not na(pBot)
        addParsed(outN, outT, outB, "Level", pBot, pBot)
    0

if barstate.isfirst and useCust
    parseLevels(txtA, pNames, pTops, pBots, zoneSeq, matchSym)
    parseLevels(lvl1, pNames, pTops, pBots, zoneSeq, matchSym)
    parseLevels(lvl2, pNames, pTops, pBots, zoneSeq, matchSym)
    parseLevels(lvl3, pNames, pTops, pBots, zoneSeq, matchSym)

abbrOf(string nm) =>
    str.length(nm) <= 6 ? nm : str.substring(nm, 0, 6)

// ════════════════════════ APPROACH FILTER ════════════════════════
approaching(int dir) =>
    bool ok = true
    if prevN > 0
        if bar_index < prevN + 1
            ok := false
        else
            if apprMono
                for i = 0 to prevN - 1
                    newer = dir == 1 ? low[i]     : high[i]
                    older = dir == 1 ? low[i + 1] : high[i + 1]
                    if dir == 1 and newer > older
                        ok := false
                    if dir == -1 and newer < older
                        ok := false
            netNew = dir == 1 ? low[0]     : high[0]
            netOld = dir == 1 ? low[prevN] : high[prevN]
            if dir == 1 and netNew >= netOld
                ok := false
            if dir == -1 and netNew <= netOld
                ok := false
    ok

// ═════════════════════════ BAND OBJECT ═════════════════════════
type Band
    string name
    string abbr
    color  col
    bool   useFar  = false
    float  fTop    = na      // fixed top/bottom, used by pasted levels only
    float  fBot    = na
    int    side    = 0
    bool   active  = false
    int    origin  = 0
    bool   appr    = false
    bool   bodyIn  = false
    bool   farHit  = false
    int    start   = 0
    int    lastSig = -100000
    bool   swOn    = false   // a break is being watched for a reclaim
    int    swBar   = 0
    int    swDir   = 0
    bool   swAppr  = false
    int    pKind   = 0       // pending type, 0 = nothing armed
    int    pDir    = 0
    int    pBar    = 0
    float  pRef    = na
    int    fired   = 0
    int    fdir    = 0

method step(Band this, float t, float b) =>
    this.fired := 0
    this.fdir  := 0
    if na(t) or na(b)
        this.side   := 0
        this.active := false
        this.pKind  := 0
        this.swOn   := false
    else
        zt     = math.max(t, b)
        zb     = math.min(t, b)
        depth  = math.max(zt - zb, syminfo.mintick)
        hitZ   = low <= zt + tol and high >= zb - tol
        cAbove = close > zt + tol
        cBelow = close < zb - tol

        // ── 1. resolve anything pending, before anything else ──
        if this.pKind != 0
            stillOut = this.pDir == 1 ? cAbove : cBelow
            if not stillOut
                this.pKind := 0
            else if bar_index - this.pBar >= waitN
                prog = not needProg or (this.pDir == 1 ? close > this.pRef : close < this.pRef)
                body = not needBody or (this.pDir == 1 ? close > open      : close < open)
                if prog and body and bar_index - this.lastSig >= cooldn
                    this.fired   := this.pKind
                    this.fdir    := this.pDir
                    this.lastSig := bar_index
                this.pKind := 0

        // ── 2. sweep watch ──
        if this.swOn
            reclaimed = this.swDir == 1 ? cAbove : cBelow
            if reclaimed
                if bar_index - this.swBar <= sweepMax and this.swAppr and useT4 and this.pKind == 0
                    this.pKind := 4
                    this.pDir  := this.swDir
                    this.pBar  := bar_index
                    this.pRef  := close
                this.swOn := false
            else if bar_index - this.swBar > sweepMax
                this.swOn := false

        // ── 3. track the interaction ──
        if not hitZ
            this.side   := close > zt ? 1 : -1
            this.active := false
            this.bodyIn := false
            this.farHit := false
        else
            if not this.active
                this.active := true
                this.origin := this.side != 0 ? this.side : (close > zt ? 1 : -1)
                this.appr   := approaching(this.origin)
                this.bodyIn := false
                this.farHit := false
                this.start  := bar_index
            bh = math.max(open, close)
            bl = math.min(open, close)
            if bl <= zt and bh >= zb
                this.bodyIn := true
            if this.useFar
                if this.origin == 1 and low <= zb + depth * (1 - farPct) + tol
                    this.farHit := true
                if this.origin == -1 and high >= zt - depth * (1 - farPct) - tol
                    this.farHit := true

            bounced = (this.origin ==  1 and cAbove) or (this.origin == -1 and cBelow)
            broke   = (this.origin ==  1 and cBelow) or (this.origin == -1 and cAbove)

            // ── 4. arm, don't fire ──
            if bounced or broke
                if bounced and this.appr and bar_index - this.start <= maxSeq and this.pKind == 0
                    kind = this.farHit ? 3 : this.bodyIn ? 2 : 1
                    on   = kind == 1 ? useT1 : kind == 2 ? useT2 : useT3
                    if on
                        this.pKind := kind
                        this.pDir  := this.origin
                        this.pBar  := bar_index
                        this.pRef  := close
                if broke and this.pKind == 0
                    this.swOn   := true
                    this.swBar  := bar_index
                    this.swDir  := this.origin
                    this.swAppr := this.appr
                this.active := false
                this.side   := cAbove ? 1 : -1
    this.fired

method sig(Band this, int dir, bool sweep) =>
    this.fired != 0 and this.fdir == dir and (sweep ? this.fired == 4 : this.fired != 4)

method hit(Band this) => this.fired != 0

method kindTxt(Band this) =>
    this.fired == 1 ? "wick" : this.fired == 2 ? "touch" : this.fired == 3 ? "back" : "sweep"

method desc(Band this) =>
    string out = ""
    if this.fired != 0
        out := this.name + " " + this.kindTxt() + " " + (this.fdir == 1 ? "up" : "down")
    out

method tagTxt(Band this) =>
    string out = ""
    if this.fired != 0
        out := (this.fired == 4 ? "~" : "") + this.abbr + (this.fdir == 1 ? "▲" : "▼")
    out

joinTxt(string acc, string s, string sep) =>
    string out = acc
    if str.length(s) > 0
        out := str.length(acc) == 0 ? s : acc + sep + s
    out

// ═══════════════════════ LEVEL SOURCES ═══════════════════════
inSess(string s) => not na(time(timeframe.period, s, tz))

nyOn   = inSess(nySess)
orOn   = inSess(orSess)
asiaOn = inSess(asiaSess)
lonOn  = inSess(lonSess)

nyStart   = nyOn   and not nyOn[1]
orStart   = orOn   and not orOn[1]
asiaStart = asiaOn and not asiaOn[1]
lonStart  = lonOn  and not lonOn[1]

ema200 = ta.ema(close, emaLen)
vwp    = ta.vwap(hlc3, nyStart)
atrv   = ta.atr(atrLen)
newDay = timeframe.change("D")

var int dayCount = 0
if newDay
    dayCount += 1

sessHL(bool on, bool started, float prevH, float prevL) =>
    float h = prevH
    float l = prevL
    if started
        h := high
        l := low
    else if on
        h := math.max(prevH, high)
        l := math.min(prevL, low)
    [h, l]

var float orH = na
var float orL = na
var int   orX = na
var float asH = na
var float asL = na
var int   asX = na
var float lnH = na
var float lnL = na
var int   lnX = na

[orH2, orL2] = sessHL(orOn,   orStart,   orH, orL)
[asH2, asL2] = sessHL(asiaOn, asiaStart, asH, asL)
[lnH2, lnL2] = sessHL(lonOn,  lonStart,  lnH, lnL)
orH := orH2
orL := orL2
asH := asH2
asL := asL2
lnH := lnH2
lnL := lnL2

if orStart
    orX := bar_index
if asiaStart
    asX := bar_index
if lonStart
    lnX := bar_index

// ── READY GATE ──
orReady = not na(orH) and (not onlyDone or not orOn)
asReady = not na(asH) and (not onlyDone or not asiaOn)
lnReady = not na(lnH) and (not onlyDone or not lonOn)

// ══════════════════════════ DRAWING ══════════════════════════
emaCol  = color.new(cEma, emaTr)
emaDots = bar_index % emaGap == 0 ? ema200 : na
plot(shEma ? emaDots : na, "EMA 200", color = emaCol, linewidth = 2, style = plot.style_circles)
plot(shVwp ? vwp : na, "VWAP (NY)", color = cVwp, linewidth = 3)

var line lnOrH = line.new(0, 0, 0, 0, width = 1, style = line.style_dotted)
var line lnOrL = line.new(0, 0, 0, 0, width = 1, style = line.style_dotted)
var line lnAsH = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnAsL = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnLnH = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)
var line lnLnL = line.new(0, 0, 0, 0, width = 1, style = line.style_dashed)

drawLvl(line ln, float lvl, int x1, color col, bool show) =>
    if na(lvl) or na(x1) or not show
        line.set_color(ln, color.new(color.black, 100))
    else
        line.set_color(ln, col)
        line.set_xy1(ln, x1, lvl)
        line.set_xy2(ln, bar_index + extRt, lvl)

drawLvl(lnOrH, orH, orX, cOr, shOr)
drawLvl(lnOrL, orL, orX, cOr, shOr)
drawLvl(lnAsH, asH, asX, cAs, shAs)
drawLvl(lnAsL, asL, asX, cAs, shAs)
drawLvl(lnLnH, lnH, lnX, cLn, shLn)
drawLvl(lnLnL, lnL, lnX, cLn, shLn)

// Pasted levels are static, so draw them once and extend both ways.
if barstate.isfirst and useCust and drawCust and pNames.size() > 0
    sty = custSty == "Solid" ? line.style_solid : custSty == "Dashed" ? line.style_dashed : line.style_dotted
    for i = 0 to pNames.size() - 1
        tp = pTops.get(i)
        bt = pBots.get(i)
        if tp == bt
            line.new(bar_index, tp, bar_index + 1, tp, xloc = xloc.bar_index,
                 extend = extend.both, color = cCust, style = sty, width = 1)
        else
            box.new(time, tp, time + 1, bt, xloc = xloc.bar_time, extend = extend.both,
                 border_color = cCust, border_style = sty, border_width = 1, bgcolor = cCustBg)

// ═══════════════════════ LINE TITLES ═══════════════════════
// style_label_left anchors the text's LEFT edge at the point, so text sits to
// the right of it, vertically centred. Transparent background = text only.
// Rebuilt each last bar because Pine garbage-collects the OLDEST labels once
// max_labels_count is reached — titles made at bar 0 would vanish first.
titleLbl(label old, string txt, float lvl, bool show, color col) =>
    if not na(old)
        label.delete(old)
    label out = na
    if lblOn and show and not na(lvl)
        full = txt + (lblPx ? "  " + str.tostring(lvl, format.mintick) : "")
        out := label.new(bar_index + lblOff, lvl, full,
             style            = label.style_label_left,
             color            = color.new(color.black, 100),
             textcolor        = col,
             size             = lblSz,
             text_font_family = lblFn,
             text_formatting  = lblWt,
             textalign        = text.align_left)
    out

var label tEma = na
var label tVwp = na
var label tOrH = na
var label tOrL = na
var label tAsH = na
var label tAsL = na
var label tLnH = na
var label tLnL = na
var array<label> tCust = array.new<label>()

if barstate.islast
    tEma := titleLbl(tEma, "EMA " + str.tostring(emaLen), ema200, shEma, cEma)
    tVwp := titleLbl(tVwp, "VWAP",        vwp, shVwp, cVwp)
    tOrH := titleLbl(tOrH, "OR High",     orH, shOr,  cOr)
    tOrL := titleLbl(tOrL, "OR Low",      orL, shOr,  cOr)
    tAsH := titleLbl(tAsH, "Asia High",   asH, shAs,  cAs)
    tAsL := titleLbl(tAsL, "Asia Low",    asL, shAs,  cAs)
    tLnH := titleLbl(tLnH, "London High", lnH, shLn,  cLn)
    tLnL := titleLbl(tLnL, "London Low",  lnL, shLn,  cLn)
    if tCust.size() > 0
        for i = 0 to tCust.size() - 1
            label.delete(tCust.get(i))
        tCust.clear()
    if useCust and drawCust and lblOn and pNames.size() > 0
        for i = 0 to pNames.size() - 1
            tp  = pTops.get(i)
            bt  = pBots.get(i)
            txt = pNames.get(i) + (lblPx ? "  " + (tp == bt ? str.tostring(tp, format.mintick)
                 : str.tostring(bt, format.mintick) + "–" + str.tostring(tp, format.mintick)) : "")
            tCust.push(label.new(bar_index + lblOff, tp, txt,
                 style            = label.style_label_left,
                 color            = color.new(color.black, 100),
                 textcolor        = cCust,
                 size             = lblSz,
                 text_font_family = lblFn,
                 text_formatting  = lblWt,
                 textalign        = text.align_left))

// ════════════════════════ BAND REGISTRY ════════════════════════
var Band bEma = Band.new(name = "EMA 200",     abbr = "EMA", col = cEma)
var Band bVwp = Band.new(name = "VWAP",        abbr = "VW",  col = cVwp)
var Band bOrH = Band.new(name = "OR High",     abbr = "ORH", col = cOr)
var Band bOrL = Band.new(name = "OR Low",      abbr = "ORL", col = cOr)
var Band bAsH = Band.new(name = "Asia High",   abbr = "ASH", col = cAs)
var Band bAsL = Band.new(name = "Asia Low",    abbr = "ASL", col = cAs)
var Band bLnH = Band.new(name = "London High", abbr = "LNH", col = cLn)
var Band bLnL = Band.new(name = "London Low",  abbr = "LNL", col = cLn)

var array<Band> custBands = array.new<Band>()
var array<Band> allBands  = array.new<Band>()

if barstate.isfirst
    allBands.push(bEma)
    allBands.push(bVwp)
    allBands.push(bOrH)
    allBands.push(bOrL)
    allBands.push(bAsH)
    allBands.push(bAsL)
    allBands.push(bLnH)
    allBands.push(bLnL)
    if useCust and pNames.size() > 0
        for i = 0 to pNames.size() - 1
            tp = pTops.get(i)
            bt = pBots.get(i)
            bd = Band.new(name = pNames.get(i), abbr = abbrOf(pNames.get(i)),
                 col = cCust, useFar = tp != bt, fTop = tp, fBot = bt)
            custBands.push(bd)
            allBands.push(bd)

// ════════════════════════ RUN ENGINE A ════════════════════════
emaSrc = shEma ? ema200 : na
vwpSrc = shVwp ? vwp : na
orHSrc = shOr and orReady ? orH : na
orLSrc = shOr and orReady ? orL : na
asHSrc = shAs and asReady ? asH : na
asLSrc = shAs and asReady ? asL : na
lnHSrc = shLn and lnReady ? lnH : na
lnLSrc = shLn and lnReady ? lnL : na

bEma.step(emaSrc, emaSrc)
bVwp.step(vwpSrc, vwpSrc)
bOrH.step(orHSrc, orHSrc)
bOrL.step(orLSrc, orLSrc)
bAsH.step(asHSrc, asHSrc)
bAsL.step(asLSrc, asLSrc)
bLnH.step(lnHSrc, lnHSrc)
bLnL.step(lnLSrc, lnLSrc)

for bd in custBands
    bd.step(bd.fTop, bd.fBot)

// ═══════════════════ ENGINE B: LFFC ═══════════════════
type Touch
    string nm
    float  top
    float  bot
    int    bar

type Setup
    string nm
    int    dir        // 1 = bullish, -1 = bearish
    float  gTop       // upper edge of the FVG
    float  gBot       // lower edge of the FVG
    float  confP      // price that must be closed through to confirm
    int    fvgBar
    int    fillBar
    int    st         // 0 = waiting for fill, 1 = filled, waiting for continuation
    box    bx

var map<string, int> lastTouchBar = map.new<string, int>()
var map<string, int> lastSigDay   = map.new<string, int>()
var array<Touch>     touches      = array.new<Touch>()
var array<Setup>     setups       = array.new<Setup>()

addLvl(array<string> ns, array<float> ts, array<float> bs, bool use, string nm, float t, float b) =>
    if use and not na(t) and not na(b)
        ns.push(nm)
        ts.push(t)
        bs.push(b)
    0

bool   lffcBull = false
bool   lffcBear = false
string lffcName = ""

// Confirmed bars only, so setups never repaint mid-bar.
if useT5 and barstate.isconfirmed and not na(atrv)
    names = array.new<string>()
    tops  = array.new<float>()
    bots  = array.new<float>()
    addLvl(names, tops, bots, shEma, "EMA " + str.tostring(emaLen), ema200, ema200)
    addLvl(names, tops, bots, shVwp, "VWAP", vwp, vwp)
    addLvl(names, tops, bots, shOr and orReady, "OR High",     orH, orH)
    addLvl(names, tops, bots, shOr and orReady, "OR Low",      orL, orL)
    addLvl(names, tops, bots, shAs and asReady, "Asia High",   asH, asH)
    addLvl(names, tops, bots, shAs and asReady, "Asia Low",    asL, asL)
    addLvl(names, tops, bots, shLn and lnReady, "London High", lnH, lnH)
    addLvl(names, tops, bots, shLn and lnReady, "London Low",  lnL, lnL)
    if useCust and pNames.size() > 0
        for i = 0 to pNames.size() - 1
            addLvl(names, tops, bots, true, pNames.get(i), pTops.get(i), pBots.get(i))

    // ── STAGE 1: register touches ──
    float ftol = fTolMode == "ATR" ? atrv * fTolAtr : fTolMode == "Ticks" ? syminfo.mintick * fTolTick : 0.0
    if names.size() > 0
        for i = 0 to names.size() - 1
            nm = names.get(i)
            tp = tops.get(i)
            bt = bots.get(i)
            if low - ftol <= tp and high + ftol >= bt
                prev = lastTouchBar.contains(nm) ? lastTouchBar.get(nm) : -999999
                if bar_index - prev >= fCool
                    lastTouchBar.put(nm, bar_index)
                    touches.push(Touch.new(nm, tp, bt, bar_index))

    if touches.size() > 0
        for i = touches.size() - 1 to 0
            if bar_index - touches.get(i).bar > maxLag
                touches.remove(i)

    // ── STAGE 2: FVG on the 3-bar window ending here ──
    disp = math.abs(close[1] - open[1])
    bull = low  > high[2] and (low - high[2]) >= atrv * minGap and disp >= atrv * minDisp and close[1] > open[1]
    bear = high < low[2]  and (low[2] - high) >= atrv * minGap and disp >= atrv * minDisp and close[1] < open[1]

    if (bull or bear) and touches.size() > 0
        int   dir  = bull ? 1 : -1
        float gBot = bull ? high[2] : high
        float gTop = bull ? low     : low[2]

        int best = -1
        for i = touches.size() - 1 to 0
            t     = touches.get(i)
            lag   = bar_index - t.bar
            okLag = lag >= minLag and lag <= maxLag
            okRej = not needRej or (dir == 1 ? close > t.top : close < t.bot)
            if okLag and okRej and best == -1
                best := i

        if best >= 0
            t = touches.get(best)
            float cp = na
            if confMode == "Close back through gap"
                cp := dir == 1 ? gTop : gBot
            else
                cp := dir == 1 ? high : low
            box bx = na
            if showFvg
                bx := box.new(bar_index - 2, gTop, bar_index, gBot,
                     border_color = color.new(dir == 1 ? color.teal : color.red, 40),
                     bgcolor = dir == 1 ? cFvgB : cFvgS)
            setups.push(Setup.new(t.nm, dir, gTop, gBot, cp, bar_index, 0, 0, bx))
            touches.remove(best)

    // ── STAGES 3 & 4: manage open setups ──
    float buf = atrv * invBuf
    if setups.size() > 0
        for i = setups.size() - 1 to 0
            s   = setups.get(i)
            mid = (s.gTop + s.gBot) / 2
            bool dead  = false
            bool fired = false

            float fillP = na
            if fillMode == "Full (far edge)"
                fillP := s.dir == 1 ? s.gBot : s.gTop
            else if fillMode == "50% (CE)"
                fillP := mid
            else
                fillP := s.dir == 1 ? s.gTop : s.gBot

            blown = s.dir == 1 ? close < s.gBot - buf : close > s.gTop + buf

            if s.st == 0
                filled = s.dir == 1 ? low <= fillP : high >= fillP
                if filled
                    s.st      := 1
                    s.fillBar := bar_index
                else if blown or bar_index - s.fvgBar > maxFill
                    dead := true

            if s.st == 1 and not dead
                conf = s.dir == 1 ? close > s.confP : close < s.confP
                ok   = not oneADay or not lastSigDay.contains(s.nm) or lastSigDay.get(s.nm) != dayCount
                if conf and ok
                    fired := true
                    dead  := true
                    lastSigDay.put(s.nm, dayCount)
                    if s.dir == 1
                        lffcBull := true
                    else
                        lffcBear := true
                    lffcName := s.nm
                else if conf and not ok
                    dead := true
                else if blown or bar_index - s.fillBar > maxConf
                    dead := true

            if not na(s.bx) and not dead
                s.bx.set_right(bar_index + 1)

            if dead
                if not na(s.bx)
                    if fired
                        s.bx.set_bgcolor(color.new(s.dir == 1 ? color.teal : color.red, 55))
                        s.bx.set_right(bar_index)
                    else
                        box.delete(s.bx)
                setups.remove(i)

// ════════════════════════ AGGREGATE ════════════════════════
cBncB = false
cBncS = false
cSwpB = false
cSwpS = false
for bd in custBands
    cBncB := cBncB or bd.sig( 1, false)
    cBncS := cBncS or bd.sig(-1, false)
    cSwpB := cSwpB or bd.sig( 1, true)
    cSwpS := cSwpS or bd.sig(-1, true)

emaBncB = bEma.sig( 1, false)
emaBncS = bEma.sig(-1, false)
emaSwpB = bEma.sig( 1, true)
emaSwpS = bEma.sig(-1, true)

vwpBncB = bVwp.sig( 1, false)
vwpBncS = bVwp.sig(-1, false)
vwpSwpB = bVwp.sig( 1, true)
vwpSwpS = bVwp.sig(-1, true)

orBncB = bOrH.sig( 1, false) or bOrL.sig( 1, false)
orBncS = bOrH.sig(-1, false) or bOrL.sig(-1, false)
orSwpB = bOrH.sig( 1, true)  or bOrL.sig( 1, true)
orSwpS = bOrH.sig(-1, true)  or bOrL.sig(-1, true)

asBncB = bAsH.sig( 1, false) or bAsL.sig( 1, false)
asBncS = bAsH.sig(-1, false) or bAsL.sig(-1, false)
asSwpB = bAsH.sig( 1, true)  or bAsL.sig( 1, true)
asSwpS = bAsH.sig(-1, true)  or bAsL.sig(-1, true)

lnBncB = bLnH.sig( 1, false) or bLnL.sig( 1, false)
lnBncS = bLnH.sig(-1, false) or bLnL.sig(-1, false)
lnSwpB = bLnH.sig( 1, true)  or bLnL.sig( 1, true)
lnSwpS = bLnH.sig(-1, true)  or bLnL.sig(-1, true)

string note = ""
string tag  = ""
for bd in allBands
    note := joinTxt(note, bd.desc(),   "  |  ")
    tag  := joinTxt(tag,  bd.tagTxt(), " ")

if lffcBull or lffcBear
    note := joinTxt(note, "FVG continuation " + (lffcBull ? "long" : "short") + " off " + lffcName, "  |  ")
    tag  := joinTxt(tag, "FVG" + (lffcBull ? "▲" : "▼"), " ")

anyBull = emaBncB or vwpBncB or orBncB or asBncB or lnBncB or cBncB or
     emaSwpB or vwpSwpB or orSwpB or asSwpB or lnSwpB or cSwpB or lffcBull
anyBear = emaBncS or vwpBncS or orBncS or asBncS or lnBncS or cBncS or
     emaSwpS or vwpSwpS or orSwpS or asSwpS or lnSwpS or cSwpS or lffcBear

// ════════════════════════ MARKERS ════════════════════════
// Colour = which level family. Shape = signal class:
//   triangle  rejection off a line     (types 1, 2)
//   diamond   rejection off a zone     (types 1, 2, 3)
//   X         sweep                    (type 4)
//   arrow     FVG continuation         (type 5)
mkOff = markBack ? -waitN : 0
lbOff = markBack ?  waitN : 0

plotshape(emaBncB, "EMA bounce up",      shape.triangleup,   location.belowbar, cEma, size = size.tiny, offset = mkOff)
plotshape(emaBncS, "EMA bounce down",    shape.triangledown, location.abovebar, cEma, size = size.tiny, offset = mkOff)
plotshape(emaSwpB, "EMA sweep up",       shape.xcross,       location.belowbar, cEma, size = size.tiny, offset = mkOff)
plotshape(emaSwpS, "EMA sweep down",     shape.xcross,       location.abovebar, cEma, size = size.tiny, offset = mkOff)

plotshape(vwpBncB, "VWAP bounce up",     shape.triangleup,   location.belowbar, cVwp, size = size.tiny, offset = mkOff)
plotshape(vwpBncS, "VWAP bounce down",   shape.triangledown, location.abovebar, cVwp, size = size.tiny, offset = mkOff)
plotshape(vwpSwpB, "VWAP sweep up",      shape.xcross,       location.belowbar, cVwp, size = size.tiny, offset = mkOff)
plotshape(vwpSwpS, "VWAP sweep down",    shape.xcross,       location.abovebar, cVwp, size = size.tiny, offset = mkOff)

plotshape(orBncB,  "OR bounce up",       shape.triangleup,   location.belowbar, cOr,  size = size.tiny, offset = mkOff)
plotshape(orBncS,  "OR bounce down",     shape.triangledown, location.abovebar, cOr,  size = size.tiny, offset = mkOff)
plotshape(orSwpB,  "OR sweep up",        shape.xcross,       location.belowbar, cOr,  size = size.tiny, offset = mkOff)
plotshape(orSwpS,  "OR sweep down",      shape.xcross,       location.abovebar, cOr,  size = size.tiny, offset = mkOff)

plotshape(asBncB,  "Asia bounce up",     shape.triangleup,   location.belowbar, cAs,  size = size.tiny, offset = mkOff)
plotshape(asBncS,  "Asia bounce down",   shape.triangledown, location.abovebar, cAs,  size = size.tiny, offset = mkOff)
plotshape(asSwpB,  "Asia sweep up",      shape.xcross,       location.belowbar, cAs,  size = size.tiny, offset = mkOff)
plotshape(asSwpS,  "Asia sweep down",    shape.xcross,       location.abovebar, cAs,  size = size.tiny, offset = mkOff)

plotshape(lnBncB,  "London bounce up",   shape.triangleup,   location.belowbar, cLn,  size = size.tiny, offset = mkOff)
plotshape(lnBncS,  "London bounce down", shape.triangledown, location.abovebar, cLn,  size = size.tiny, offset = mkOff)
plotshape(lnSwpB,  "London sweep up",    shape.xcross,       location.belowbar, cLn,  size = size.tiny, offset = mkOff)
plotshape(lnSwpS,  "London sweep down",  shape.xcross,       location.abovebar, cLn,  size = size.tiny, offset = mkOff)

plotshape(cBncB,   "Pasted bounce up",   shape.diamond,      location.belowbar, cCust, size = size.tiny, offset = mkOff)
plotshape(cBncS,   "Pasted bounce down", shape.diamond,      location.abovebar, cCust, size = size.tiny, offset = mkOff)
plotshape(cSwpB,   "Pasted sweep up",    shape.xcross,       location.belowbar, cCust, size = size.tiny, offset = mkOff)
plotshape(cSwpS,   "Pasted sweep down",  shape.xcross,       location.abovebar, cCust, size = size.tiny, offset = mkOff)

plotshape(lffcBull, "FVG continuation long",  shape.arrowup,   location.belowbar, color.teal, size = size.small)
plotshape(lffcBear, "FVG continuation short", shape.arrowdown, location.abovebar, color.red,  size = size.small)

if showLb and (anyBull or anyBear)
    label.new(bar_index - lbOff, anyBull ? low[lbOff] : high[lbOff], tag,
         style     = anyBull ? label.style_label_up : label.style_label_down,
         color     = color.new(anyBull ? color.green : color.red, 25),
         textcolor = color.white, size = size.tiny, tooltip = note)

// ════════════════════════ ALERTS ════════════════════════
// One condition per level family, either direction, any signal type, plus
// cross-cutting conditions for sweeps and FVG continuations. The dynamic
// alert() carries full detail but only fires under "Any alert() function
// call", which covers everything.
sEma = bEma.hit()
sVwp = bVwp.hit()
sOrH = bOrH.hit()
sOrL = bOrL.hit()
sAsH = bAsH.hit()
sAsL = bAsL.hit()
sLnH = bLnH.hit()
sLnL = bLnL.hit()
sCst = cBncB or cBncS or cSwpB or cSwpS
sSwp = emaSwpB or emaSwpS or vwpSwpB or vwpSwpS or orSwpB or orSwpS or
     asSwpB or asSwpS or lnSwpB or lnSwpS or cSwpB or cSwpS
sFvg = lffcBull or lffcBear
sAny = anyBull or anyBear

alertcondition(sEma, "EMA 200 bounce",     "EMA 200 bounce")
alertcondition(sVwp, "VWAP bounce",        "NY VWAP bounce")
alertcondition(sOrH, "1H OR High bounce",  "1H opening range high bounce")
alertcondition(sOrL, "1H OR Low bounce",   "1H opening range low bounce")
alertcondition(sAsH, "Asia High bounce",   "Asia session high bounce")
alertcondition(sAsL, "Asia Low bounce",    "Asia session low bounce")
alertcondition(sLnH, "London High bounce", "London session high bounce")
alertcondition(sLnL, "London Low bounce",  "London session low bounce")
alertcondition(sCst, "Pasted level bounce", "Pasted level or zone bounce")
alertcondition(sSwp, "Any sweep",          "Sweep reclaimed on any level")
alertcondition(lffcBull, "FVG continuation long",  "Bullish level → FVG → fill → continuation confirmed")
alertcondition(lffcBear, "FVG continuation short", "Bearish level → FVG → fill → continuation confirmed")
alertcondition(sFvg, "Any FVG continuation", "Level → FVG → fill → continuation confirmed")
alertcondition(sAny, "Any signal", "Confirmed bounce, sweep or FVG continuation")

if sAny
    alert(syminfo.ticker + " " + timeframe.period + "  " + note, alert.freq_once_per_bar)

//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Zone Touch Engine
//
//  IMPORTANT: Pine cannot read drawings you made with the chart's drawing
//  tools. line.all / box.all only contain objects THIS script created.
//  So: define the levels here (typed or clicked), the script draws them,
//  then it enumerates them and reacts when price touches.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Zone Touch Engine", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────── INPUTS ───────────────────────────
gH   = "Horizontal levels"
hStr = input.string("", "Levels (comma separated)", group = gH,
     tooltip = "e.g.  4500, 4522.75, 4610")

gR   = "Rectangle  (click 2 corners)"
rOn  = input.bool(false, "Enable", group = gR)
rExt = input.bool(true,  "Extend right", group = gR)
rt1  = input.time (timestamp("01 Jan 2024 00:00"), "Corner A", confirm = true, inline = "rA", group = gR)
rp1  = input.price(0.0, "", confirm = true, inline = "rA", group = gR)
rt2  = input.time (timestamp("01 Jan 2024 00:00"), "Corner B", confirm = true, inline = "rB", group = gR)
rp2  = input.price(0.0, "", confirm = true, inline = "rB", group = gR)

gY   = "Ray  (click 2 points)"
yOn  = input.bool(false, "Enable", group = gY)
yt1  = input.time (timestamp("01 Jan 2024 00:00"), "Point A", confirm = true, inline = "yA", group = gY)
yp1  = input.price(0.0, "", confirm = true, inline = "yA", group = gY)
yt2  = input.time (timestamp("01 Jan 2024 00:00"), "Point B", confirm = true, inline = "yB", group = gY)
yp2  = input.price(0.0, "", confirm = true, inline = "yB", group = gY)

gT      = "Touch"
tol     = input.float(0.0,  "Tolerance (price units)", minval = 0, group = gT)
useWick = input.bool (true, "Use wicks (off = bodies only)", group = gT)

barTop = useWick ? high : math.max(open, close)
barBot = useWick ? low  : math.min(open, close)

// ──────────────── BUILD THE OBJECTS ONCE (bar 0) ────────────────
// Anything created here lands in line.all / box.all and becomes enumerable.
var box rZone = na

if barstate.isfirst
    if str.length(hStr) > 0
        for s in str.split(hStr, ",")
            v = str.tonumber(str.replace_all(s, " ", ""))
            if not na(v)
                line.new(time, v, time + 1, v, xloc = xloc.bar_time,
                     extend = extend.both, color = color.new(color.yellow, 30))
    if rOn
        rZone := box.new(math.min(rt1, rt2), math.max(rp1, rp2),
             math.max(rt1, rt2), math.min(rp1, rp2), xloc = xloc.bar_time,
             border_color = color.blue, bgcolor = color.new(color.blue, 88))
    if yOn
        line.new(yt1, yp1, yt2, yp2, xloc = xloc.bar_time,
             extend = extend.right, color = color.orange, width = 2)

if rExt and not na(rZone)
    box.set_right(rZone, time)

// ─────────────────────── GEOMETRY HELPER ───────────────────────
// line.get_price() only works on xloc.bar_index lines, so interpolate by time.
lineY(line ln) =>
    x1 = line.get_x1(ln)
    y1 = line.get_y1(ln)
    x2 = line.get_x2(ln)
    y2 = line.get_y2(ln)
    float out = na
    if x2 == x1
        out := y2
    else
        frac = (time - x1) * 1.0 / (x2 - x1)   // *1.0 avoids int division
        out := y1 + (y2 - y1) * frac
    out

// ──────────────── ENUMERATE + TEST ON EVERY BAR ────────────────
var array<string> hits = array.new<string>()
array.clear(hits)

// Lines and rays. NOTE: every line this script makes is extended, so its
// price is valid at any bar. If you add plain segments, also check that
// `time` sits between x1 and x2 — Pine has no getter for a line's extend.
for ln in line.all
    p = lineY(ln)
    if not na(p) and barBot - tol <= p and barTop + tol >= p
        array.push(hits, "line " + str.tostring(p, format.mintick))

// Boxes: overlap in time AND in price.
for bx in box.all
    bl = box.get_left(bx)
    br = box.get_right(bx)
    bt = box.get_top(bx)
    bb = box.get_bottom(bx)
    inTime  = time >= bl and time <= br
    inPrice = barBot <= bt + tol and barTop >= bb - tol
    if inTime and inPrice
        array.push(hits, "zone " + str.tostring(bb, format.mintick) + "-" + str.tostring(bt, format.mintick))

nHits    = array.size(hits)
newTouch = nHits > 0 and nz(nHits[1]) == 0   // fires once per entry, not every bar inside

// ──────────────────── DO SOMETHING WITH IT ────────────────────
bgcolor(nHits > 0 ? color.new(color.aqua, 92) : na)
plotshape(newTouch, "Touch", shape.triangleup, location.belowbar, color.aqua, size = size.tiny)

if newTouch
    label.new(bar_index, low, str.tostring(nHits) + "×",
         style = label.style_label_up, color = color.new(color.aqua, 20),
         textcolor = color.black, size = size.tiny,
         tooltip = array.join(hits, "\n"))
    alert("TOUCH " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) +
         " -> " + array.join(hits, " | "), alert.freq_once_per_bar)

alertcondition(newTouch, "Level touched", "Price touched a drawn level")
